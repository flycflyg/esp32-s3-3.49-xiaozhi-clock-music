+
+static int LunarLeapMonth(int y) {
+    return (int)(kLunarInfo[y - 1900] & 0xf);
+}
+
+static int LunarLeapDays(int y) {
+    if (LunarLeapMonth(y) == 0) {
+        return 0;
+    }
+    return (kLunarInfo[y - 1900] & 0x10000) ? 30 : 29;
+}
+
+static int LunarMonthDays(int y, int m) {
+    return (kLunarInfo[y - 1900] & (0x10000u >> m)) ? 30 : 29;
+}
+
+static int LunarYearDays(int y) {
+    int sum = 348;
+    for (uint32_t i = 0x8000; i > 0x8; i >>= 1) {
+        if (kLunarInfo[y - 1900] & i) {
+            sum++;
+        }
+    }
+    return sum + LunarLeapDays(y);
+}
+
+/* 公历 → 距 1970-01-01 的天数（Howard Hinnant days_from_civil，纯整数、不碰时区） */
+static long DaysFromCivil(int y, int m, int d) {
+    y -= (m <= 2);
+    const int era = (y >= 0 ? y : y - 399) / 400;
+    const unsigned yoe = (unsigned)(y - era * 400);
+    const unsigned doy = (unsigned)((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1);
+    const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    return (long)era * 146097L + (long)doe - 719468L;
+}
+
+static const char* kLunarMonthName[] = {"", "正", "二", "三", "四", "五", "六",
+                                        "七", "八", "九", "十", "冬", "腊"};
+static const char* kLunarDayName[] = {
+    "", "初一", "初二", "初三", "初四", "初五", "初六", "初七", "初八", "初九", "初十",
+    "十一", "十二", "十三", "十四", "十五", "十六", "十七", "十八", "十九", "二十",
+    "廿一", "廿二", "廿三", "廿四", "廿五", "廿六", "廿七", "廿八", "廿九", "三十"};
+
+/* 公历 → 「十月初二」/「闰六月初一」；超出表范围返回 false */
+static bool SolarToLunarText(int sy, int sm, int sd, char* out, size_t out_len) {
+    if (sy < 1900 || sy > 2100) {
+        return false;
+    }
+    long offset = DaysFromCivil(sy, sm, sd) - DaysFromCivil(1900, 1, 31);
+    if (offset < 0) {
+        return false;
+    }
+    int y = 1900;
+    while (y < 2101) {
+        int yd = LunarYearDays(y);
+        if (offset < yd) {
+            break;
+        }
+        offset -= yd;
+        y++;
+    }
+    if (y > 2100) {
+        return false;
+    }
+
+    int leap = LunarLeapMonth(y);
+    int mo = 1;
+    bool is_leap = false;
+    while (mo <= 12) {
+        if (leap != 0 && mo == leap + 1) {   /* 处理第 mo 月之前先吃掉闰月 */
+            int md = LunarLeapDays(y);
+            if (offset < md) {
+                is_leap = true;
+                break;
+            }
+            offset -= md;
+        }
+        int md = LunarMonthDays(y, mo);
+        if (offset < md) {
+            is_leap = false;
+            break;
+        }
+        offset -= md;
+        mo++;
+    }
+    if (mo > 12) {
+        return false;
+    }
+
+    /* ★闰月用「前一个月号」命名：2025 年是闰六月，不是闰七月 */
+    int lm = is_leap ? mo - 1 : mo;
+    int ld = (int)offset + 1;
+    snprintf(out, out_len, "%s%s月%s", is_leap ? "闰" : "", kLunarMonthName[lm],
+             kLunarDayName[ld]);
+    return true;
+}
