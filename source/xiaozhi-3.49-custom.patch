+    if (lv_strcmp(lv_label_get_text(battery_pct_label_), buf) == 0) {
+        return;                 /* 没变就不动，省得每 tick 刷屏 */
+    }
+    lv_label_set_text(battery_pct_label_, buf);
+    /* 主题/字体可能被换过，顺手重设，保证数字一直能显示 */
+    LvglTheme* lvgl_theme = static_cast<LvglTheme*>(GetTheme());
+    if (lvgl_theme != nullptr && lvgl_theme->text_font() != nullptr) {
+        lv_obj_set_style_text_font(battery_pct_label_, lvgl_theme->text_font()->font(), 0);
+        lv_obj_set_style_text_color(battery_pct_label_, lvgl_theme->text_color(), 0);
