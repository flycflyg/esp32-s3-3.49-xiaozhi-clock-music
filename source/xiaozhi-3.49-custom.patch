+#ifndef MUSIC_UI_H
+#define MUSIC_UI_H
+
+#include <atomic>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include <lvgl.h>
+
+#include "device_state.h"
+
+class Display;
+class AudioService;
+
+/**
+ * 本地音乐界面（TF 卡 MP3）
+ *
+ * 小智固件没有「页面」概念 —— LcdDisplay 直接建在 lv_screen_active() 上，
+ * 没有可切换的 screen 栈。所以这里做成**盖在聊天界面之上的全屏覆盖层**：
+ * 一个和屏幕等大的 lv_obj，默认 HIDDEN，显示时 move_to_index(-1) 置顶。
+ * 关闭只是隐藏它，聊天界面原样还在。
+ *
+ * 两个视图：
+ *   - 歌单页：列出 TF 卡根目录的 .mp3，点一首开始播
+ *   - 播放页：歌名 + 进度条 + 时间 + [上一首][播放/暂停][下一首][歌单][关闭]
+ *
+ * 字体说明（重要）：
+ *   固件内建的是 font_noto_sans_basic_30_4，其中文只覆盖语言文件里那几条固定字符串，
+ *   实测缺「之乐仰公客尘栈歌痛红队」等字 —— 歌名会显示成方块。
+ *   但构建脚本会自动把 _basic_ 换成 _common_ 打进 assets 分区，
+ *   开机时 assets.cc 读到 text_font_meta.charset=="common" 就 display->SetTextFont(common)，
+ *   换成 6845 字的 common 字体。所以：
+ *   **界面必须延迟到第一次 Show() 时才建**，那时 common 字体已就位，
+ *   从主题取字体才能拿到带汉字的那个。
+ *
+ * 线程安全：
+ *   LVGL 的锁是递归互斥量（esp_lvgl_port: xSemaphoreCreateRecursiveMutex），
+ *   且 lv_timer_handler() 本身就在锁内调用，所以
+ *   任意任务里用 DisplayLockGuard 都一样安全，lv_timer 回调里再取锁也不会死锁。
+ */
+class MusicUi {
+public:
+    static MusicUi& GetInstance();
+
+    /**
+     * 由板级构造完 display / SD 之后调用。
+     * 只保存引用与歌单，**不建任何 LVGL 对象**（等 common 字体就位）。
+     */
+    void Initialize(Display* display, std::vector<std::string> files, AudioService* audio);
+
+    bool IsAvailable() const { return display_ != nullptr && !files_.empty(); }
+
+    /** BOOT 键双击：关着就开、开着就关 */
+    void Toggle();
+    void Show();
+    void Hide();
+    bool IsVisible() const { return visible_; }
+
+    /**
+     * 主题字体被换掉时必须调用（谁换的都要调：控制台改字体/主题/壁纸、assets 刷新）。
+     *
+     * 为什么必须：主题里的字体是 std::shared_ptr<LvglFont>，LvglDisplay::SetTextFont()
+     * 换上新的之后，上游只保证「它自己那些控件」的样式已重绑，紧接着就让旧字体对象
+     * 析构（上游注释原话："Keep the previous font owners alive until the current theme
+     * has rebound every style to the new font."）。本界面这套覆盖层的控件不在上游
+     * 重绑名单里 —— BuildLocked() 存下的 text_font()->font() 裸指针会指向已释放内存，
+     * 下次重绘就踩空（同款崩溃：Guru Meditation InstrFetchProhibited / PC=0x0）。
+     *
+     * 两个字体指针都没变就直接返回：light<->dark 互换主题时两个主题共用同一份字体
+     * 对象，指针不变，界面不动，不会因为一句「换个主题」就把音乐界面关掉。
+     */
+    void OnThemeFontsChanged(const lv_font_t* text_font, const lv_font_t* icon_font);
+
+    /**
+     * 语音互斥（策略 A）：唤醒/说话时暂停音乐，回到空闲再续播。
+     *
+     * 由 DeviceStateMachine 的监听器调用，可能在任意任务的上下文里执行，
+     * 所以这里**只碰原子变量**（MusicPlayer 的 Pause/Resume 就是设原子标志），
+     * 不碰 LVGL；界面刷新交给 lv_timer。
+     */
+    void OnDeviceStateChanged(DeviceState state);
+
+private:
+    MusicUi() = default;
+    MusicUi(const MusicUi&) = delete;
+    MusicUi& operator=(const MusicUi&) = delete;
+
+    /* 以下 *Locked 结尾的函数都要求调用者已持有显示锁 */
+    void BuildLocked();
+    /* ★两个页面只允许一个可见：任何切页都显式设置全部页面的可见性。 */
+    enum class Page { kMusicList, kMusicPlayer };
+    void ShowOnlyLocked(Page page);
+
+    void ShowListLocked();
+    void ShowPlayerLocked();
+    void PlayIndexLocked(int index);
+    void UpdatePlayerLocked();
+    void SetVisibleLocked(bool on);
+
+    static void TimerCb(lv_timer_t* t);
+    static void SongRowCb(lv_event_t* e);
+    static void PrevCb(lv_event_t* e);
+    static void NextCb(lv_event_t* e);
+    static void PlayPauseCb(lv_event_t* e);
+    static void ListCb(lv_event_t* e);
+    static void CloseCb(lv_event_t* e);
+
+
+    Display*      display_ = nullptr;
+    AudioService* audio_   = nullptr;
+    std::vector<std::string> files_;
+
+    lv_obj_t* root_        = nullptr;
+    lv_obj_t* list_page_   = nullptr;
+    lv_obj_t* player_page_ = nullptr;
+    lv_obj_t* list_cont_   = nullptr;
+    lv_obj_t* title_lbl_   = nullptr;
+    lv_obj_t* time_lbl_    = nullptr;
+    lv_obj_t* bar_         = nullptr;
+    lv_obj_t* play_lbl_    = nullptr;
+    lv_timer_t* timer_     = nullptr;
+    /* 建界面时用的字体指针：用来判断主题换字体后要不要整棵重建 */
+    const lv_font_t* build_text_font_ = nullptr;
+    const lv_font_t* build_icon_font_ = nullptr;
+
+    int  index_        = -1;     /* 当前曲目下标，-1 = 没在播 */
+    bool visible_      = false;
+    bool voice_paused_ = false;  /* 因语音而暂停 → 回到 idle 要续播 */
+};
+
+#endif  // MUSIC_UI_H
diff --git a/main/audio/voice_enhance.cc b/main/audio/voice_enhance.cc
new file mode 100644
index 0000000..caec79b
--- /dev/null
+++ b/main/audio/voice_enhance.cc
@@ -0,0 +1,190 @@
+#include "voice_enhance.h"
+
+#include <cmath>
+#include <esp_log.h>
+#include <esp_timer.h>
+
+namespace {
+constexpr const char* TAG = "VoiceEnhance";
+
+/* ★★★ 总开关：true = 只压不放的保护器（不加任何增益）★★★
+ * 演进过程（别再重犯）：
+ *   v1~v4 做的是「自动增益 + 峰值上限」→ 一路爆音。根因：真实 TTS 峰值在 43%~90%
+ *   之间剧烈跳变，任何固定峰值上限都会让限幅器全程工作；而抬增益又把持续功率推高。
+ *   v5（2026-11-10 最终版）：完全旁路后用户仍报 1 分钟后爆音，落盘数据给出答案 ——
+ *   输入 RMS 最高到 18.4%，**正好落在当初音乐破音的那个区间（18~20%）**。
+ *   也就是说：TTS 本身就有过响段落，喇叭在音量 90 下扛不住那个持续功率。
+ *   修法直接复用音乐那套已验证的「只压不放」AGC：增益上限 1.0，只把过响段落压回 12%。
+ *   ★不加增益、不设峰值上限、不做软限幅★ —— 这三样正是前面四版爆音的来源。 */
+constexpr bool kEnabled = false;
+/* ↑ 当前关闭（纯旁路）。2026-11-10 最终定位：数字信号已证明完全干净
+ *   （297/297 行 in_peak == out_peak、无满幅样本、无限幅），失真在模拟侧（功放/喇叭），
+ *   且表现为「时间相关」而非「内容相关」：前 1 分钟任何句子都干净，1 分钟后几乎整句都爆。
+ *   这种签名是热积累，软件层面的压缩/限幅都治不了，只能降音量或换硬件。
+ *   下面的「只压不放」实现保留作备用：若将来确认是某个频段能量过高（而不是热），
+ *   把 kEnabled 改成 true 即可启用（它只压不放，不会像 v1~v4 那样把功率推高）。 */
+
+/* 目标 RMS 与音乐 AGC 保持一致（音乐是 4000/32768 = 12.2%）。
+ * 实测本板在音量 90 下，持续 RMS 超过 18% 就破音；压到 12% 完全干净。 */
+constexpr float kTargetRms = 0.12f;
+/* ★只压不放：增益上限就是 1.0，绝不放大。
+ * 这一点是整个方案的根基 —— 只要不放大，就不可能把持续功率推高、不可能热失真。 */
+constexpr float kMaxGain = 1.0f;
+/* 最多压到 0.35（-9 dB），和音乐 AGC 一致。 */
+constexpr float kMinGain = 0.35f;
+/* 噪声门：静音段不处理（判【本帧】RMS，不用平滑值，否则停顿里会一直压）。 */
+constexpr float kNoiseGate = 0.010f;
+
+
+/* ★★增益限速的方向必须是「压得快、放得慢」★★
+ * 增益需要下降 = 来了响的信号（压缩器的 attack）→ 必须快，否则峰值被软限幅长时间啃 = 失真
+ * 增益需要上升 = 信号变安静（release）→ 必须慢，否则泵浦
+ * 上一版写成「升 6% / 降 4%」，方向正好反了：增益只会上不会下，连续对话几十秒后
+ * 就一路爬到 170%+ 并停在那里 —— 这就是「前几句正常、越说越爆」的根因。 */
+constexpr float kGainAttack = 0.25f;    /* 每帧最多降 25% */
+constexpr float kGainRelease = 0.03f;   /* 每帧最多升 3% */
+
+/* 帧间隔超过这个值就认为一句话结束了 → 状态归位，绝不让增益跨句累积。
+ * TTS 一句说完后解码器空闲，Process() 根本不会被调用，所以必须靠时间戳判断。 */
+constexpr int64_t kUtteranceGapUs = 300000;   /* 300 ms */
+
+/* RMS 平滑系数（每帧一次）→ 时间常数约 200 ms。 */
+constexpr float kRmsSmooth = 0.25f;
+
+constexpr float kFullScale = 32768.0f;
+}  // namespace
+
+/* 【诊断用】最近一次统计的全局快照 */
+
+void VoiceEnhance::Process(std::vector<int16_t>& pcm) {
+    if (pcm.empty()) {
+        return;
+    }
+
+    /* 0) 句间归位：距上一帧超过 300 ms 就当作新的一句话，状态全部重置 */
+    const int64_t now_us = esp_timer_get_time();
+    if (last_us_ != 0 && now_us - last_us_ > kUtteranceGapUs) {
+        rms_avg_ = 0.0f;
+        gain_ = 1.0f;
+    }
+    last_us_ = now_us;
+
+    /* 1) 本帧峰值与 RMS（先看完整帧，再决定增益 —— 等于自带 lookahead） */
+    int peak = 0;
+    double sum_sq = 0.0;
+    double sum = 0.0;
+    for (auto s : pcm) {
+        sum_sq += (double)s * (double)s;
+        sum += (double)s;
+        const int a = s < 0 ? -s : s;
+        if (a > peak) {
+            peak = a;
+        }
+    }
+    const float rms = (float)(sqrt(sum_sq / (double)pcm.size()) / kFullScale);
+    rms_avg_ += (rms - rms_avg_) * kRmsSmooth;
+    /* 直流偏移：不对称削波（听感「持续发毛」）的常见来源，单独记下来 */
+    const float dc = (float)(fabs(sum / (double)pcm.size()) / kFullScale);
+    if ((int)(dc * 10000.0f) > window_.in_dc) {
+        window_.in_dc = (int)(dc * 10000.0f);
+    }
+
+    /* ★旁路模式（kEnabled == false）：只做测量给诊断用，一个样本都不改。 */
+    if (!kEnabled) {
+        if (peak > window_.in_peak) {
+            window_.in_peak = peak;
+        }
+        if ((int)(rms_avg_ * kFullScale) > window_.in_rms) {
+            window_.in_rms = (int)(rms_avg_ * kFullScale);
+        }
+        if (peak > window_.out_peak) {
+            window_.out_peak = peak;
+        }
+        window_.gain_pct = 100;
+        return;
+    }
+
+    /* 2) 响度目标：只压不放（与音乐 AGC 完全同构）
+     * ★噪声门必须看「本帧」的 RMS，不能看平滑值★
+     * 平滑值有 200 ms 惯性，字间停顿时还在门限以上，于是在停顿里继续压 —— 泵浦。 */
+    float desired = 1.0f;
+    if (rms >= kNoiseGate) {
+        desired = kTargetRms / rms_avg_;
+        if (desired > kMaxGain) {
+            desired = kMaxGain;      /* ★1.0，绝不放大 */
+        }
+        if (desired < kMinGain) {
+            desired = kMinGain;      /* 最多 -9 dB */
+        }
+    }
+
+    /* 3) 限速：压得快、放得慢 */
+    float delta_gain = desired - gain_;
+    const float limit = (delta_gain > 0.0f) ? kGainRelease : kGainAttack;
+    if (delta_gain > limit) {
+        delta_gain = limit;
+    } else if (delta_gain < -limit) {
+        delta_gain = -limit;
+    }
+    float g_apply = gain_ + delta_gain;
+    if (g_apply > kMaxGain) {
+        g_apply = kMaxGain;
+    } else if (g_apply < kMinGain) {
+        g_apply = kMinGain;
+    }
+
+    /* 4) 帧内线性插值 + int16 钳位
+     * ★这里不做软限幅、不设峰值上限★ —— 增益上限已经是 1.0，峰值只会变小不会变大，
+     * 峰值根本不可能被推上去；前面四版爆音正是因为多加了那一层限幅。 */
+    const size_t n = pcm.size();
+    const float step = (n > 1) ? (g_apply - gain_) / (float)(n - 1) : 0.0f;
+    float g = gain_;
+    int out_peak = 0;
+    for (size_t i = 0; i < n; ++i) {
+        float v = (float)pcm[i] * g;
+        int32_t iv = (int32_t)v;
+        if (iv > 32767) {
+            iv = 32767;
+        } else if (iv < -32768) {
+            iv = -32768;
+        }
+        pcm[i] = (int16_t)iv;
+        const int ai = iv < 0 ? -(int)iv : (int)iv;
+        if (ai > out_peak) {
+            out_peak = ai;
+        }
+        g += step;
+    }
+    gain_ = g_apply;
+
+    /* 7) 统计（每秒打印一次） */
+    if (peak > window_.in_peak) {
+        window_.in_peak = peak;
+    }
+    /* ★in_rms 记录 AGC 实际使用的平滑 RMS（不是单帧最大值）——
+     * 这个值直接决定增益，日志里才能一眼看出增益为什么是那个数。
+     * （上一版记的是单帧最大 RMS 16.5%，看着像"已经够响了"，实际平滑值只有 8.5%，
+     *   把自己也误导了，导致增益被推到 156% 还没发现。） */
+    if ((int)(rms_avg_ * kFullScale) > window_.in_rms) {
+        window_.in_rms = (int)(rms_avg_ * kFullScale);
+    }
+    if (out_peak > window_.out_peak) {
+        window_.out_peak = out_peak;
+    }
+    window_.gain_pct = (int)(gain_ * 100.0f + 0.5f);
+}
+
+VoiceEnhance::Stats VoiceEnhance::TakeStats() {
+    Stats s = window_;
+    last_ = s;
+    window_ = Stats{};
+    return s;
+}
+
+void VoiceEnhance::Reset() {
+    rms_avg_ = 0.0f;
+    gain_ = 1.0f;
+    last_us_ = 0;
+    window_ = Stats{};
+    last_ = Stats{};
+}
diff --git a/main/audio/voice_enhance.h b/main/audio/voice_enhance.h
new file mode 100644
index 0000000..5d22dc2
--- /dev/null
+++ b/main/audio/voice_enhance.h
@@ -0,0 +1,47 @@
+#ifndef VOICE_ENHANCE_H
+#define VOICE_ENHANCE_H
+
+#include <cstdint>
+#include <vector>
+
+/**
+ * 语音响度增强（只用于小智说话的 TTS 链路，音乐有 MusicPlayer 自己的 AGC，互不影响）。
+ *
+ * 目标：音量设置不变（比如 90），但人耳听到的更响。
+ * 原理：人耳的响度感知更接近 RMS（有效值）而不是峰值。语音的波峰因数通常在 12~18 dB，
+ *       也就是峰值离满幅还有空间、但有效能量很低。这里把 RMS 抬到目标值（只抬不压），
+ *       同时用峰值限幅把峰值硬压在 -1 dBFS 以内 —— 所以「更响」但绝不削波。
+ *
+ * 线程模型：非线程安全，只在 OpusCodecTask 里调用（单任务）。
+ */
+class VoiceEnhance {
+public:
+    struct Stats {
+        int in_peak = 0;
+        int in_rms = 0;
+        int in_dc = 0;    /* 直流偏移，单位 0.01% 满幅（10 = 0.1%） */
+        int out_peak = 0;
+        int gain_pct = 100;
+        int limited = 0;
+    };
+
+    /** 就地处理一帧 PCM（单声道 int16）。 */
+    void Process(std::vector<int16_t>& pcm);
+
+    /** 取走并清零本窗口的统计（每秒打印一次用）。 */
+    Stats TakeStats();
+
+    /** 查看最近一个统计窗口的值（不清零，供诊断轮询用）。 */
+    Stats PeekLast() const { return last_; }
+
+    void Reset();
+
+private:
+    float rms_avg_ = 0.0f;    // 平滑后的输入 RMS（0~1）
+    float gain_ = 1.0f;       // 当前增益（跨帧保留，但绝不跨句）
+    int64_t last_us_ = 0;     // 上一帧的时间戳，用来判断「新的一句话开始了」
+    Stats window_{};
+    Stats last_{};            // 最近一个已结算窗口（不清零）
+};
+
+#endif  // VOICE_ENHANCE_H
