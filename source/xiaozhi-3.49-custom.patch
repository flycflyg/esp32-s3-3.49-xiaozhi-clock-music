+#ifndef STANDBY_CLOCK_H
+#define STANDBY_CLOCK_H
+
+#include <cstdint>
+
+#include <lvgl.h>
+
+#include "device_state.h"
+
+class Display;
+
+/**
+ * 待机翻页时钟（苹果风）
+ *
+ * 设计原则（★不碰小智对话链路）：
+ *   - 纯覆盖层：和 MusicUi 一样盖在 lv_screen_active() 上，默认 HIDDEN，
+ *     显示时 move_to_index(-1) 置顶。**不改上游聊天界面的任何一行**。
+ *   - 只在 kDeviceStateIdle 且延迟 N 秒后才出现；任何非 idle 状态立刻让位。
+ *   - 语音唤醒词照旧有效：AFE 一直在跑，唤醒 → 状态变 listening → 本层自动隐藏，
+ *     所以「待机时钟下说唤醒词」天然可用，不需要额外接线。
+ *   - 触摸/按键唤醒：本层根对象可点击，点一下 = Application::ToggleChatState()，
+ *     和 BOOT 单击走同一条路。
+ *
+ * 线程模型：
+ *   - OnDeviceStateChanged 可能在任意任务上下文被调用 → 只改标志位，不碰 LVGL。
+ *   - 真正的显示/隐藏/刷新由 200ms 的 lv_timer 在 LVGL 任务里做。
+ */
+class StandbyClock {
+public:
+    static StandbyClock& GetInstance();
+
+    /** 板级构造完 display 后调用：存引用 + 订阅状态机 */
+    void Initialize(Display* display);
+
+    /** 状态机监听器调用（任意任务上下文，只碰标志位） */
+    void OnDeviceStateChanged(DeviceState state);
+
+    /** 主题换字体时必须调用：整棵树销毁，下次按新字体重建（同 MusicUi 的做法） */
+    void OnThemeFontsChanged(const lv_font_t* text_font, const lv_font_t* icon_font);
+
+    bool IsVisible() const { return visible_; }
+
+    void Show();
+    void Hide();
+
+private:
+    StandbyClock() = default;
+    StandbyClock(const StandbyClock&) = delete;
+    StandbyClock& operator=(const StandbyClock&) = delete;
+
+    /* 以下 *Locked 都要求调用者已持有显示锁 */
+    void BuildLocked();
+    void RefreshLocked(bool force);
+    void DestroyLocked();
+
+    static void TimerCb(lv_timer_t* t);
+    static void RootClickCb(lv_event_t* e);
+    static void FlapAnimCb(void* var, int32_t v);
+
+    Display* display_ = nullptr;
+
+    lv_obj_t* root_      = nullptr;
+    lv_obj_t* card_[2]   = {nullptr, nullptr};   /* 0=时 1=分 */
+    lv_obj_t* digit_[2]  = {nullptr, nullptr};
+    lv_obj_t* flap_[2]   = {nullptr, nullptr};   /* 翻页盖板（高度 0 → 卡片高） */
+    lv_obj_t* date_lbl_    = nullptr;   /* 左侧竖排：11月10日 */
+    lv_obj_t* date_yr_lbl_ = nullptr;   /* 左侧竖排：2026年（右列） */
+    lv_obj_t* week_lbl_    = nullptr;   /* 右侧竖排：星期二 */
+    lv_obj_t* lunar_lbl_   = nullptr;   /* 右侧外列竖排农历：十月初二 */
+    lv_timer_t* timer_   = nullptr;
+
+    const lv_font_t* build_text_font_ = nullptr;
+    const lv_font_t* build_icon_font_ = nullptr;
+
+    bool visible_ = false;
+    int  last_hh_ = -1;
+    int  last_mm_ = -1;
+    int  last_yday_ = -1;
+
+    /* 状态机侧写、LVGL 侧读 */
+    volatile bool want_show_   = false;   /* 当前是否 idle */
+    volatile uint32_t idle_since_ms_ = 0; /* 进入 idle 的时刻（lv_tick） */
+};
+
+#endif  // STANDBY_CLOCK_H
