+
+#define TAG "MusicPlayer"
+
+#define MUSIC_TASK_STACK      (6 * 1024)
+#define MUSIC_TASK_PRIORITY   (3)
+
+/* 音乐播放软件 headroom：154/256 ≈ 0.6016（约 -4.4 dB）。
+ * 理由见播放循环里的注释（响度战争的母带 + 系统音量 90 → 削波破音）。 */
+/* 静态 headroom：★恢复为 1.0（256/256）★
+ * 原来 154/256 = -4.4 dB，是为「高响度曲子破音」留的余量；
+ * 该问题已确诊为机械共振并物理修复，这个静态衰减一并撤掉，恢复原厂音量。 */
+#define MUSIC_GAIN_NUM        (256)
+#define MUSIC_GAIN_DEN        (256)
+
+/* 音乐专用响度自适应（AGC）：只压不放。
+ * 实测依据：红尘客栈 RMS 10~15% 时干净，公路之歌整首 RMS 18~20.6% 就破音，
+ * 而两首歌都没有数字削波（满幅样本 0）⇒ 是模拟侧被持续高响度顶爆。
+ * 固定压音量会把安静的段落一起压闷，所以按 RMS 动态压，目标 12% 满幅。 */
+/* ★音乐 AGC 总开关：0 = 关闭（2026-11-10）★
+ * 关闭理由同 MUSIC_MAX_VOLUME：它当年是为了压住「高响度曲子破音」，
+ * 而那个破音已确诊为机械共振并物理修复。现在音乐走原厂电平，不做任何压缩。 */
+#define MUSIC_AGC_ENABLE       (0)
+
+#define MUSIC_AGC_TARGET_RMS   (4000.0)   /* ≈12.2% 满幅（实测干净区间上沿） */
+#define MUSIC_AGC_MIN_GAIN     (0.35)
+#define MUSIC_AGC_RMS_SMOOTH   (0.08)     /* 每帧平滑系数 → 时间常数约 300 ms */
+#define MUSIC_AGC_ATTACK       (0.20)     /* 需要压时收敛快 */
+#define MUSIC_AGC_RELEASE      (0.03)     /* 放开时慢，避免泵浦 */
+
+/* 音乐播放期间加深输出队列：默认 2 块 × 341 ms 余量偏小，
+ * 解码+重采样任务一旦被抢占就会让 I2S 断流（听感同样是"破音/咔哒"）。
+ * 播完必须还原成语音路径的默认值，否则 TTS 延迟会被拉长。 */
+#define MUSIC_PLAYBACK_QUEUE_DEPTH  (3)
+
+/* 音乐播放期间的系统音量上限。
+ * ★2026-11-10 起不再限幅（100 = 不生效）★
+ * 原来设 75 的理由是「系统音量 90 时公路之歌整首 RMS 18~20% 会破音」，
+ * 后来确诊那是**喇叭与硬壳之间缓冲胶老化导致的机械共振**（按住外壳失真消失）。
+ * 换泡棉后整首歌无失真 ⇒ 这个上限和下面的 AGC 都只是当年的权宜之计，现已撤掉，
+ * 音乐音量恢复为跟随系统音量（和原厂行为一致）。 */
+#define MUSIC_MAX_VOLUME            (100)
+#define MUSIC_READ_CHUNK      (4 * 1024)   /* 旧的固定块读取（已废弃，保留供参考） */
+#define MUSIC_WINDOW_BYTES    (32 * 1024)  /* 滑动窗口大小：32KB 可容 30 个 320kbps 帧 */
+#define MUSIC_OUT_BYTES       (8 * 1024)   /* 单帧解码输出缓冲 */
+#define MUSIC_PUSH_SAMPLES    (8192)       /* 累积约 340ms@24k 再推队列 */
+#define MUSIC_QUEUE_RETRY_MS  (5)          /* 队列满时的重试间隔 */
+#define MUSIC_STOP_WAIT_MS    (3000)       /* Stop() 等待任务退出的上限 */
+
+#define MUSIC_RATE_CVT_CFG(_src_rate, _dest_rate, _channel)   \
+    (esp_ae_rate_cvt_cfg_t)                                   \
+    {                                                         \
+        .src_rate        = (uint32_t)(_src_rate),             \
+        .dest_rate       = (uint32_t)(_dest_rate),            \
+        .channel         = (uint8_t)(_channel),               \
+        .bits_per_sample = ESP_AUDIO_BIT16,                   \
+        .complexity      = 3,                                 \
+        .perf_type       = ESP_AE_RATE_CVT_PERF_TYPE_SPEED,   \
+    }
+
+MusicPlayer& MusicPlayer::GetInstance() {
+    static MusicPlayer instance;
+    return instance;
+}
+
+void MusicPlayer::Initialize(AudioService* audio_service) {
+    audio_service_ = audio_service;
+    ESP_LOGI(TAG, "MusicPlayer 初始化完成");
+}
+
+bool MusicPlayer::StopAndWait(int timeout_ms) {
+    if (task_handle_ == nullptr) {
+        playing_.store(false);
+        return true;
+    }
+    stop_requested_.store(true);
+    paused_.store(false);
+    /* 必须等任务真正退出（不只是 playing_ 变 false）：收尾阶段的栈还没释放 */
+    for (int waited = 0; waited < timeout_ms && (playing_.load() || task_alive_.load()); waited += 20) {
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+    if (playing_.load() || task_alive_.load()) {
+        ESP_LOGW(TAG, "播放任务未在 %d ms 内退出", timeout_ms);
+        return false;
+    }
+    task_handle_ = nullptr;
+    return true;
+}
+
+bool MusicPlayer::PlayFile(const std::string& path) {
+    if (audio_service_ == nullptr) {
+        ESP_LOGE(TAG, "未初始化：audio_service 为空");
+        return false;
+    }
+
+    struct stat st;
+    if (stat(path.c_str(), &st) != 0 || st.st_size <= 0) {
+        ESP_LOGE(TAG, "文件不存在或为空: %s", path.c_str());
+        return false;
+    }
+
+    if (!StopAndWait(MUSIC_STOP_WAIT_MS)) {
+        ESP_LOGE(TAG, "上一次播放未退出，放弃本次播放");
+        return false;
+    }
+
+    current_file_ = path;
+    stop_requested_.store(false);
+    paused_.store(false);
+    finished_naturally_.store(false);   /* 新的一曲开始，清掉上一曲的「自然播完」标志 */
+    position_ms_.store(0);
+    duration_ms_.store(0);
+    sample_rate_.store(0);
+    channels_.store(0);
+    playing_.store(true);
+
+    /* 创建播放任务。播放期间内部 SRAM 只剩 ~14 KB，6 KB 连续栈偶尔分配不到
+     * （旧任务刚退出、堆还没合并），所以重试几次而不是直接失败。 */
+    task_alive_.store(true);
+    BaseType_t created = pdFAIL;
+    for (int attempt = 0; attempt < 6 && created != pdPASS; ++attempt) {
+        if (attempt > 0) {
+            vTaskDelay(pdMS_TO_TICKS(100));
+        }
+        created = xTaskCreate(TaskEntry, "music_play", MUSIC_TASK_STACK, this,
+                              MUSIC_TASK_PRIORITY, &task_handle_);
+    }
+    if (created != pdPASS) {
+        ESP_LOGE(TAG, "创建播放任务失败（重试 6 次仍失败，内部 SRAM %u）",
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL));
+        task_handle_ = nullptr;
+        task_alive_.store(false);
+        playing_.store(false);
+        return false;
+    }
+
+    /* 音乐期间加深输出队列：防止解码/重采样被抢占时 I2S 断流（播完在 TaskEntry 里还原） */
+    audio_service_->SetPlaybackQueueLimit(MUSIC_PLAYBACK_QUEUE_DEPTH);
+
+    /* 音乐期间把音量限到 75（只降不升；只改硬件不写 NVS） */
+    auto* codec = Board::GetInstance().GetAudioCodec();
+    if (codec != nullptr) {
+        if (!volume_limited_) {
+            /* 已经被限过就别重读，否则会把 75 当成「用户音量」记下来 */
+            saved_volume_ = codec->output_volume();
+        }
+        ApplyVolumeLimit(true);
+        ESP_LOGI(TAG, "音乐期间音量 %d → %d（防破音，不写 NVS）",
+                 saved_volume_, volume_limited_ ? MUSIC_MAX_VOLUME : saved_volume_);
+    }
+
+    ESP_LOGI(TAG, "开始播放: %s (%ld 字节)", path.c_str(), (long)st.st_size);
+    return true;
+}
+
+bool MusicPlayer::Stop() {
+    bool ok = StopAndWait(MUSIC_STOP_WAIT_MS);
+    if (ok) {
+        ESP_LOGI(TAG, "已停止播放");
+    }
+    return ok;
+}
+
+void MusicPlayer::ApplyVolumeLimit(bool limit) {
+    auto* codec = Board::GetInstance().GetAudioCodec();
+    if (codec == nullptr) {
+        return;
+    }
+    if (limit) {
+        if (saved_volume_ > MUSIC_MAX_VOLUME) {
+            codec->SetOutputVolumeTemporary(MUSIC_MAX_VOLUME);
+            volume_limited_ = true;
+        } else {
+            volume_limited_ = false;   /* 用户本来就比 75 小，不用压 */
+        }
+    } else if (volume_limited_) {
+        codec->SetOutputVolumeTemporary(saved_volume_);
+        volume_limited_ = false;
+    }
+}
+
+void MusicPlayer::Pause() {
+    if (playing_.load()) {
+        paused_.store(true);
+        /* 暂停期间不出音乐 → 把音量还给语音，否则小智说话也被压到 75 */
+        ApplyVolumeLimit(false);
+        ESP_LOGI(TAG, "已暂停（音量已还给语音）");
+    }
+}
+
+void MusicPlayer::Resume() {
+    if (playing_.load() && paused_.load()) {
+        paused_.store(false);
+        ApplyVolumeLimit(true);
+        ESP_LOGI(TAG, "继续播放（音量重新限到 %d）", MUSIC_MAX_VOLUME);
+    }
+}
+
+void MusicPlayer::TaskEntry(void* arg) {
+    auto* self = static_cast<MusicPlayer*>(arg);
+    self->PlaybackLoop();
+    self->playing_.store(false);
+    self->task_handle_ = nullptr;
+
+    /* 还原语音路径的输出队列深度（音乐期间是加深过的） */
+    if (self->audio_service_ != nullptr) {
+        self->audio_service_->SetPlaybackQueueLimit(MAX_PLAYBACK_TASKS_IN_QUEUE);
+    }
+
+    /* 还原音乐期间被限制的音量（只改硬件，不动 NVS）。
+     * 若播放期间用户自己改过音量，以用户为准，不覆盖。 */
+    if (self->volume_limited_) {
+        auto* codec = Board::GetInstance().GetAudioCodec();
+        if (codec != nullptr && codec->output_volume() == MUSIC_MAX_VOLUME) {
+            self->ApplyVolumeLimit(false);
+            ESP_LOGI(TAG, "音乐结束，音量还原为 %d", self->saved_volume_);
+        } else {
+            self->volume_limited_ = false;
+            ESP_LOGI(TAG, "音量已被手动修改，不还原");
+        }
+    }
+    /* 最后一步：告诉别人「栈可以放心回收了」，然后才真正删自己 */
+    self->task_alive_.store(false);
+    vTaskDelete(nullptr);
+}
+
+void MusicPlayer::DiagnoseFile(const std::string& path) {
+    static const char* TAGD = "SDDiag";
+    FILE* fp = fopen(path.c_str(), "rb");
+    if (fp == nullptr) {
+        ESP_LOGE(TAGD, "打不开: %s", path.c_str());
+        return;
+    }
+    fseek(fp, 0, SEEK_END);
+    long fsize = ftell(fp);
+    fseek(fp, 0, SEEK_SET);
+
+    const char* base = strrchr(path.c_str(), '/');
+    ESP_LOGI(TAGD, "=============== %s ===============", base ? base + 1 : path.c_str());
+    ESP_LOGI(TAGD, "  文件大小: %ld 字节", fsize);
+
+    uint8_t h[10] = {};
+    size_t hn = fread(h, 1, sizeof(h), fp);
+    if (hn >= 10) {
+        ESP_LOGI(TAGD, "  头 10 字节: %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X",
+                 h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8], h[9]);
+    }
+
+    long audio_off = 0;
+    if (hn >= 10 && h[0] == 'I' && h[1] == 'D' && h[2] == '3') {
+        uint32_t tag = ((uint32_t)(h[6] & 0x7F) << 21) | ((uint32_t)(h[7] & 0x7F) << 14) |
+                       ((uint32_t)(h[8] & 0x7F) << 7)  |  (uint32_t)(h[9] & 0x7F);
+        audio_off = 10 + (long)tag;
+        ESP_LOGI(TAGD, "  ID3v2 2.%d.%d 标志0x%02X 标签 %u 字节", h[3], h[4], h[5], (unsigned)tag);
+        ESP_LOGI(TAGD, "  -> 音频应从偏移 %ld 开始（占全文 %.1f%%）", audio_off,
+                 fsize ? (double)audio_off * 100.0 / (double)fsize : 0.0);
+    } else {
+        ESP_LOGI(TAGD, "  无 ID3v2 标签，音频从 0 开始");
+    }
+
+    if (fseek(fp, audio_off, SEEK_SET) == 0) {
+        uint8_t a[32] = {};
+        size_t an = fread(a, 1, sizeof(a), fp);
+        if (an >= 32) {
+            for (int row = 0; row < 4; row++) {
+                ESP_LOGI(TAGD, "  音频+%02d: %02X %02X %02X %02X %02X %02X %02X %02X", row * 8,
+                         a[row*8+0], a[row*8+1], a[row*8+2], a[row*8+3],
+                         a[row*8+4], a[row*8+5], a[row*8+6], a[row*8+7]);
+            }
+            if (a[0] == 0xFF && (a[1] & 0xE0) == 0xE0) {
+                int ver = (a[1] >> 3) & 3, lay = (a[1] >> 1) & 3;
+                int br  = (a[2] >> 4) & 0xF, sr = (a[2] >> 2) & 3;
+                const int brv[16] = {0,32,40,48,56,64,80,96,112,128,160,192,224,256,320,0};
+                const int srv[4]  = {44100,48000,32000,0};
+                ESP_LOGI(TAGD, "  首帧头: %s 层%d %d kbps %d Hz", 
+                         ver == 3 ? "MPEG1" : (ver == 2 ? "MPEG2" : (ver == 0 ? "MPEG2.5" : "保留")),
+                         4 - lay, brv[br], srv[sr]);
+            } else {
+                ESP_LOGI(TAGD, "  !! 音频起始不是合法 MP3 同步字 (%02X %02X)", a[0], a[1]);
+            }
+        }
+    }
+
+    if (fseek(fp, audio_off, SEEK_SET) == 0) {
+        std::vector<uint8_t> buf(65536);
+        size_t n = fread(buf.data(), 1, buf.size(), fp);
+        int sync_count = 0, first_off = -1, prev_off = -1, nspac = 0, spac[6] = {0};
+        for (size_t i = 0; i + 3 < n; i++) {
+            if (buf[i] == 0xFF && (buf[i+1] & 0xE0) == 0xE0) {
+                int lay = (buf[i+1] >> 1) & 3, ver = (buf[i+1] >> 3) & 3;
+                int br  = (buf[i+2] >> 4) & 0xF, sr = (buf[i+2] >> 2) & 3;
+                if (lay != 0 && ver != 1 && br != 0 && br != 15 && sr != 3) {
+                    sync_count++;
+                    if (first_off < 0) first_off = (int)i;
+                    if (prev_off >= 0 && nspac < 6) spac[nspac++] = (int)i - prev_off;
+                    prev_off = (int)i;
+                }
+            }
+        }
+        ESP_LOGI(TAGD, "  扫 %u 字节: 合法帧头 %d 个, 首个@%d", (unsigned)n, sync_count, first_off);
+        if (nspac > 0) {
+            ESP_LOGI(TAGD, "  相邻间距: %d %d %d %d %d %d", spac[0], spac[1], spac[2], spac[3], spac[4], spac[5]);
+        }
+        ESP_LOGI(TAGD, "  参照: 128k=417  192k=626  320k=1044 字节; 对不上=不是正常MP3");
+    }
+    fclose(fp);
+}
+
+void MusicPlayer::PlaybackLoop() {
+    const std::string path = current_file_;
+
+    FILE* fp = fopen(path.c_str(), "rb");
+    if (fp == nullptr) {
+        ESP_LOGE(TAG, "fopen 失败: %s", path.c_str());
+        return;
+    }
+
+    void* decoder = nullptr;
+    esp_audio_err_t derr = esp_mp3_dec_open(nullptr, 0, &decoder);
+    if (derr != ESP_AUDIO_ERR_OK || decoder == nullptr) {
+        ESP_LOGE(TAG, "MP3 解码器打开失败: %d", (int)derr);
+        fclose(fp);
+        return;
+    }
+
+    const int out_rate = audio_service_->GetOutputSampleRate();
+    ESP_LOGI(TAG, "MP3 解码器就绪，输出目标 %d Hz", out_rate);
+
+    // ---- 先看文件头，再按规范跳过 ID3v2 标签 ----
+    // 中文歌普遍带几百 KB 的专辑封面，解码器会在封面数据里误撞到「假帧头」，
+    // 于是解出 12000Hz/单声道 之类的垃圾 PCM —— 听感就是杂音。
+    // 打印文件头同时也是实证：如果开头不是 ID3 也不是 MP3 同步字（比如 ftyp），
+    // 说明这压根不是 MP3 文件。
+    long audio_start = 0;   /* 音频真实起始偏移（ID3v2 之后）。算时长必须减掉标签体积，
+                             * 否则带大封面的歌会多算十几秒。 */
+    {
+        uint8_t hdr[10] = {};
+        size_t got = fread(hdr, 1, sizeof(hdr), fp);
+        if (got >= 3) {
+            ESP_LOGI(TAG, "文件头: %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X",
+                     hdr[0], hdr[1], hdr[2], hdr[3], hdr[4], hdr[5], hdr[6], hdr[7], hdr[8], hdr[9]);
+        }
+        if (got >= 10 && hdr[0] == 'I' && hdr[1] == 'D' && hdr[2] == '3') {
+            uint32_t tag_size = ((uint32_t)(hdr[6] & 0x7F) << 21) |
+                                ((uint32_t)(hdr[7] & 0x7F) << 14) |
+                                ((uint32_t)(hdr[8] & 0x7F) << 7)  |
+                                 (uint32_t)(hdr[9] & 0x7F);
+            long skip = 10 + (long)tag_size;
+            if (fseek(fp, skip, SEEK_SET) == 0) {
+                audio_start = skip;
+                ESP_LOGI(TAG, "检测到 ID3v2 标签（%u 字节），已跳过，从偏移 %ld 开始解码",
+                         (unsigned)tag_size, skip);
+            } else {
+                fseek(fp, 0, SEEK_SET);
+                ESP_LOGW(TAG, "ID3v2 跳过失败，回到文件开头");
+            }
+        } else if (got >= 2 && hdr[0] == 0xFF && (hdr[1] & 0xE0) == 0xE0) {
+            fseek(fp, 0, SEEK_SET);
+            ESP_LOGI(TAG, "没有 ID3 标签，开头就是 MP3 同步字");
+        } else {
+            fseek(fp, 0, SEEK_SET);
+            ESP_LOGW(TAG, "开头既不是 ID3 也不是 MP3 同步字（%02X %02X）—— 可能根本不是 MP3 文件",
+                     hdr[0], hdr[1]);
+        }
+    }
+
+    /* 滑动窗口：MP3 帧会跨越读取边界，必须让解码器始终看到连续数据。
+     * 教训：旧版固定 4096 字节块 + 帧长 1044 字节(320kbps) => 每块只能装 3 整帧
+     * 加 964 字节残帧；残帧凑不满一帧时解码器无法推进，旧代码把整块剩余全丢掉，
+     * 于是永久错位、每块丢 23% 数据、解出大量垃圾帧 —— 听感就是杂音。 */
+    std::vector<uint8_t>  win(MUSIC_WINDOW_BYTES);
+    size_t win_have = 0;   /* 窗口内有效字节数 */
+    size_t win_pos  = 0;   /* 窗口内已消费到的位置 */
+
+    std::vector<uint8_t>  frame_buf(MUSIC_OUT_BYTES);
+    std::vector<int16_t>  mono_buf;
+    std::vector<int16_t>  accum;
+    accum.reserve(MUSIC_PUSH_SAMPLES * 2);
+
+    esp_ae_rate_cvt_handle_t resampler = nullptr;
+    int   src_rate = 0;
+    int   src_channel = 0;
+    uint64_t out_samples_total = 0;
+    bool push_failed = false;
+    int consecutive_errors = 0;   // 连续解码失败计数
+    int ok_frames = 0;            // 成功解出的帧数
+
+    /* 【播放监测】用来定位「播放几秒后音量变大 + 破音」：
+     * 记录每秒推送 PCM 的峰值幅度（满幅 = 32768）与当前软件音量。
+     * 峰值一直贴着满幅 → 音源本身就顶到天花板（需要留 headroom）；
+     * 峰值稳定但人耳听到变响 → 增益在 codec / 模拟侧，不在数据里。 */
+    int     probe_peak = 0;
+    int64_t probe_log_us = 0;
+    double  probe_sum_sq = 0.0;      /* 【探针】这一秒的平方和，用来算 RMS（有效响度） */
+    int     probe_sq_n = 0;
+
+    /* 响度自适应状态（跨批次保留） */
+    double  agc_gain = 1.0;
+    double  agc_rms_avg = 0.0;
+
+    /* 【探针】削波指纹 + 推送间隔（I2S 断流指纹）：
+     * 满幅样本数/最长连续满幅段 → 判断「音源自己就削波了」（压音量救不回来）
+     * 推送间隔 > 400 ms → 队列被抽空、I2S 断流（听感是咔哒/破音） */
+    int64_t probe_clip_samples = 0;
+    int64_t probe_clip_run = 0;
+    int64_t probe_clip_run_max = 0;
+    int64_t probe_total_samples = 0;
+    int64_t probe_last_push_us = 0;
+    int     probe_gap_warn = 0;
+    int64_t probe_gap_max_us = 0;
+
+    /* 解码器完全无法推进时：跳到窗口内下一个疑似 MP3 同步字（字节级重同步，
+     * 而不是一次丢掉整块数据） */
+    auto resync_forward = [&]() {
+        for (size_t i = win_pos + 1; i + 1 < win_have; ++i) {
+            if (win[i] == 0xFF && (win[i + 1] & 0xE0) == 0xE0) {
+                win_pos = i;
+                return;
+            }
+        }
+        win_pos = win_have;
+    };
+
+    while (!stop_requested_.load()) {
+        while (paused_.load() && !stop_requested_.load()) {
+            vTaskDelay(pdMS_TO_TICKS(20));
+        }
+        if (stop_requested_.load()) {
+            break;
+        }
+
+        /* 1) 把未消费的残帧挪到窗口头部 */
+        if (win_pos > 0) {
+            if (win_have > win_pos) {
+                memmove(win.data(), win.data() + win_pos, win_have - win_pos);
+                win_have -= win_pos;
+            } else {
+                win_have = 0;
+            }
+            win_pos = 0;
+        }
+
+        /* 2) 追加新数据补满窗口 */
+        if (win_have < win.size()) {
+            size_t got = fread(win.data() + win_have, 1, win.size() - win_have, fp);
+            win_have += got;
+        }
+        if (win_have == 0) {
+            break;  /* 文件读完 */
+        }
+
+        esp_audio_dec_in_raw_t raw = {};
+        raw.buffer        = win.data() + win_pos;
+        raw.len           = (uint32_t)(win_have - win_pos);
+        raw.consumed      = 0;
+        raw.frame_recover = ESP_AUDIO_DEC_RECOVERY_NONE;
+
+        esp_audio_dec_out_frame_t frame = {};
+        frame.buffer       = frame_buf.data();
+        frame.len          = (uint32_t)frame_buf.size();
+        frame.decoded_size = 0;
+
+        esp_audio_dec_info_t info = {};
+        esp_audio_err_t ret = esp_mp3_dec_decode(decoder, &raw, &frame, &info);
+        win_pos += raw.consumed;
+
+        if (ret == ESP_AUDIO_ERR_BUFF_NOT_ENOUGH) {
+            if (frame.needed_size > frame_buf.size()) {
+                ESP_LOGW(TAG, "输出缓冲不足，扩容 %u -> %u 字节",
+                         (unsigned)frame_buf.size(), (unsigned)frame.needed_size);
+                frame_buf.resize(frame.needed_size);
+            }
+            if (raw.consumed == 0) {
+                ESP_LOGW(TAG, "解码器未消费数据（缓冲不足），向前重同步");
+                resync_forward();
+            }
+            continue;
+        }
+        if (ret != ESP_AUDIO_ERR_OK) {
+            /* 帧头未同步 / 坏帧：丢掉已消费数据继续找下一个同步字 */
+            if (++consecutive_errors >= 200) {
+                ESP_LOGE(TAG, "连续 %d 次解码失败（成功 %d 帧），判定为无法解码的文件，"
+                              "立刻停止以避免制造噪音", consecutive_errors, ok_frames);
+                push_failed = true;
+                break;
+            }
+            if (raw.consumed == 0) {
+                resync_forward();
+            }
+            continue;
+        }
+        consecutive_errors = 0;
+        ok_frames++;
+
+        if (frame.decoded_size == 0) {
+            continue;
+        }
+
+        if (src_rate == 0) {
+            src_rate    = (int)info.sample_rate;
+            src_channel = (int)info.channel;
+            sample_rate_.store(src_rate);
+            channels_.store(src_channel);
+            if (info.bitrate > 0) {
+                struct stat st;
+                if (stat(path.c_str(), &st) == 0) {
+                    /* info.bitrate 的单位是 kbps（实测值是 320，不是 320000）。
+                     * 旧代码当 bps 用，结果时长大了 1000 倍（195843625 ms）。
+                     * 时长(ms) = 音频字节数 * 8 / kbps
+                     * 另外要减掉 ID3v2 标签：那是元数据不是音频，
+                     * 实测某首歌封面 438993 字节，不减会多算 11 秒。 */
+                    uint64_t audio_bytes = (uint64_t)st.st_size;
+                    if (audio_start > 0 && (uint64_t)audio_start < audio_bytes) {
+                        audio_bytes -= (uint64_t)audio_start;
+                    }
+                    duration_ms_.store((int)(audio_bytes * 8ULL / (uint64_t)info.bitrate));
+                }
+            }
+            ESP_LOGI(TAG, "MP3 信息: %d Hz / %d 声道 / %u kbps / 时长约 %d ms",
+                     src_rate, src_channel, (unsigned)info.bitrate, duration_ms_.load());
+            if (src_rate != out_rate) {
+                esp_ae_rate_cvt_cfg_t cfg = MUSIC_RATE_CVT_CFG(src_rate, out_rate, ESP_AUDIO_MONO);
+                esp_ae_err_t rerr = esp_ae_rate_cvt_open(&cfg, &resampler);
+                if (rerr != ESP_AE_ERR_OK || resampler == nullptr) {
+                    ESP_LOGE(TAG, "重采样器创建失败(%d)，将按原始采样率输出", (int)rerr);
+                    resampler = nullptr;
+                } else {
+                    ESP_LOGI(TAG, "重采样器就绪: %d -> %d Hz", src_rate, out_rate);
+                }
+            }
+        }
+
+        int16_t* pcm = reinterpret_cast<int16_t*>(frame_buf.data());
+        size_t sample_count = frame.decoded_size / sizeof(int16_t);
+
+        /* 播放链路是 ESP_AUDIO_MONO，立体声需下混（取左右平均） */
+        if (src_channel == 2) {
+            size_t frames = sample_count / 2;
+            mono_buf.resize(frames);
+            for (size_t i = 0; i < frames; ++i) {
+                mono_buf[i] = (int16_t)(((int32_t)pcm[i * 2] + (int32_t)pcm[i * 2 + 1]) / 2);
+            }
+            pcm = mono_buf.data();
+            sample_count = frames;
+        }
+        if (sample_count == 0) {
+            continue;
+        }
+
+        std::vector<int16_t> chunk;
+        if (resampler != nullptr) {
+            uint32_t max_out = 0;
+            if (esp_ae_rate_cvt_get_max_out_sample_num(resampler, (uint32_t)sample_count, &max_out) == ESP_AE_ERR_OK
+                && max_out > 0) {
+                chunk.resize(max_out);
+                uint32_t produced = max_out;
+                if (esp_ae_rate_cvt_process(resampler, (esp_ae_sample_t)pcm, (uint32_t)sample_count,
+                                            (esp_ae_sample_t)chunk.data(), &produced) == ESP_AE_ERR_OK) {
+                    chunk.resize(produced);
+                } else {
+                    chunk.assign(pcm, pcm + sample_count);
+                }
+            } else {
+                chunk.assign(pcm, pcm + sample_count);
+            }
+        } else {
+            chunk.assign(pcm, pcm + sample_count);
+        }
+        if (chunk.empty()) {
+            continue;
+        }
+
+        /* ★音乐专用软件 headroom（不改系统音量，不影响小智语音）。
+         * 实测：320kbps 的流行母带普遍是「响度战争」产物，峰值贴着 100% 满幅
+         * （本曲实测 91~100%，最高 32767），叠加系统音量 90 后 ES8311 DAC + 功放削波，
+         * 听感就是破音。这里统一压到 ~70% 满幅（约 -3.1 dB），把余量留给模拟侧。 */
+        for (auto& s : chunk) {
+            int32_t v = ((int32_t)s * MUSIC_GAIN_NUM) / MUSIC_GAIN_DEN;
+            if (v > 32767) {
+                v = 32767;
+            } else if (v < -32768) {
+                v = -32768;
+            }
+            s = (int16_t)v;
+        }
+
+        /* ★响度自适应（AGC，只压不放）：静态 headroom 之后再做一次。
+         * 目的：公路之歌这种整首 RMS 18~20% 的曲子要压下来，红尘客栈的安静段落保持原样。
+         * 只压不放（增益上限 1.0）→ 不会把安静段落放大，也不会抬噪声。 */
+        {
+#if MUSIC_AGC_ENABLE
+            double sum_sq = 0.0;
+            for (size_t i = 0; i < chunk.size(); ++i) {
+                sum_sq += (double)chunk[i] * (double)chunk[i];
+            }
+            const double rms = chunk.empty() ? 0.0 : sqrt(sum_sq / (double)chunk.size());
+            /* RMS 先平滑（约 300 ms 时间常数），避免跟着鼓点泵浦 */
+            agc_rms_avg += (rms - agc_rms_avg) * MUSIC_AGC_RMS_SMOOTH;
+
+            double target = 1.0;
+            if (agc_rms_avg > 1.0) {
+                target = MUSIC_AGC_TARGET_RMS / agc_rms_avg;
+            }
+            if (target > 1.0) {
+                target = 1.0;              /* 只压不放 */
+            }
+            if (target < MUSIC_AGC_MIN_GAIN) {
+                target = MUSIC_AGC_MIN_GAIN;
+            }
+            const double step = (target < agc_gain) ? MUSIC_AGC_ATTACK : MUSIC_AGC_RELEASE;
+            const double agc_next = agc_gain + (target - agc_gain) * step;
+
+            /* 批内线性渐变，避免批次边界出现增益跳变（听感是咔哒） */
+            const size_t n = chunk.size();
+            const double delta = (n > 1) ? (agc_next - agc_gain) / (double)(n - 1) : 0.0;
+            double g = agc_gain;
+            for (size_t i = 0; i < n; ++i) {
+                int32_t v = (int32_t)((double)chunk[i] * g);
+                if (v > 32767) {
+                    v = 32767;
+                } else if (v < -32768) {
+                    v = -32768;
+                }
+                chunk[i] = (int16_t)v;
+                g += delta;
+            }
+            agc_gain = agc_next;
+#else
+            (void)agc_rms_avg;
+            agc_gain = 1.0;      /* AGC 关闭：增益恒 1.0，音乐原样输出 */
+#endif
+        }
+
+        accum.insert(accum.end(), chunk.begin(), chunk.end());
+
+        if (accum.size() >= MUSIC_PUSH_SAMPLES) {
+            const size_t want = accum.size();
+            /* 【播放监测】峰值必须在 std::move 之前算（move 之后 accum 就空了） */
+            int batch_peak = 0;
+            double batch_sum_sq = 0.0;
+            for (size_t i = 0; i < want; ++i) {
+                int v = accum[i] < 0 ? -(int)accum[i] : (int)accum[i];
+                if (v > batch_peak) {
+                    batch_peak = v;
+                }
+                batch_sum_sq += (double)accum[i] * (double)accum[i];
+                /* 削波指纹：连续顶到满幅的样本段 */
+                if (v >= 32700) {
+                    ++probe_clip_samples;
+                    if (++probe_clip_run > probe_clip_run_max) {
+                        probe_clip_run_max = probe_clip_run;
+                    }
+                } else {
+                    probe_clip_run = 0;
+                }
+            }
+            probe_total_samples += (int64_t)want;
+            probe_sum_sq += batch_sum_sq;
+            probe_sq_n += (int)want;
+
+            /* 推送间隔：队列被抽空会让下一次推送明显迟到 */
+            {
+                const int64_t t_push = esp_timer_get_time();
+                if (probe_last_push_us != 0) {
+                    const int64_t gap = t_push - probe_last_push_us;
+                    if (gap > 400000) {
+                        ++probe_gap_warn;
+                        if (gap > probe_gap_max_us) {
+                            probe_gap_max_us = gap;
+                        }
+                        /* 不再每次打日志：队列 3 块（约 1 s）能吸收这种抖动，
+                         * 只有队列真被抽空才会断流，看每曲汇总里的次数就够 */
+                    }
+                }
+                probe_last_push_us = t_push;
+            }
+            const uint32_t ts = 0;  /* 传 0：AudioOutputTask 会把 >0 的 timestamp 塞进服务端 AEC 的 timestamp_queue_，音乐不能掺进去 */
+            bool accepted = false;
+            while (!stop_requested_.load()) {
+                if (audio_service_->PushPcmToPlayback(std::move(accum), ts)) {
+                    accepted = true;
+                    break;
+                }
+                vTaskDelay(pdMS_TO_TICKS(MUSIC_QUEUE_RETRY_MS));
+            }
+            if (!accepted) {
+                push_failed = true;
+                break;
+            }
+            out_samples_total += want;
+            position_ms_.store((int)(out_samples_total * 1000ULL / (uint64_t)out_rate));
+            accum.clear();
+            accum.reserve(MUSIC_PUSH_SAMPLES * 2);
+
+            /* 【播放监测】每秒一条：峰值幅度 + 软件音量 */
+            if (batch_peak > probe_peak) {
+                probe_peak = batch_peak;
+            }
+            const int64_t now_us = esp_timer_get_time();
+            if (probe_log_us == 0) {
+                probe_log_us = now_us;
+            }
+            if (now_us - probe_log_us >= 1000000) {
+                auto* codec = Board::GetInstance().GetAudioCodec();
+                const int rms = probe_sq_n > 0 ? (int)(sqrt(probe_sum_sq / (double)probe_sq_n) + 0.5) : 0;
+                ESP_LOGI(TAG, "播放监测: 峰值 %d (%.1f%%) RMS %d / AGC %d%% / 音量 %d / 已播 %d ms / 内部RAM %u",
+                         probe_peak, probe_peak * 100.0 / 32768.0, rms,
+                         (int)(agc_gain * 100.0 + 0.5),
+                         codec != nullptr ? codec->output_volume() : -1,
+                         position_ms_.load(),
+                         (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL));
+                probe_peak = 0;
+                probe_sum_sq = 0.0;
+                probe_sq_n = 0;
+                probe_log_us = now_us;
+            }
+        }
+    }
+
+    /* 收尾：把不足一批的尾巴推出去 */
+    if (!push_failed && !stop_requested_.load() && !accum.empty()) {
+        const size_t want = accum.size();
+        const uint32_t ts = 0;  /* 传 0：AudioOutputTask 会把 >0 的 timestamp 塞进服务端 AEC 的 timestamp_queue_，音乐不能掺进去 */
+        for (int tries = 0; tries < 200 && !stop_requested_.load(); ++tries) {
+            if (audio_service_->PushPcmToPlayback(std::move(accum), ts)) {
+                out_samples_total += want;
+                position_ms_.store((int)(out_samples_total * 1000ULL / (uint64_t)out_rate));
+                break;
+            }
+            vTaskDelay(pdMS_TO_TICKS(MUSIC_QUEUE_RETRY_MS));
+        }
+    }
+
+    if (resampler != nullptr) {
+        esp_ae_rate_cvt_close(resampler);
+    }
+    esp_mp3_dec_close(decoder);
+    fclose(fp);
+
+    if (stop_requested_.load()) {
+        ESP_LOGI(TAG, "播放被停止: %s", path.c_str());
+    } else if (push_failed) {
+        ESP_LOGE(TAG, "音频队列持续满，放弃播放: %s", path.c_str());
+    } else {
+        ESP_LOGI(TAG, "播放结束: %s（%d ms）", path.c_str(), position_ms_.load());
+        /* 自然播完（不是被停止、不是队列满放弃）→ 置位供 UI 自动续播下一首 */
+        finished_naturally_.store(true);
+    }
+
+    /* 【探针·本曲汇总】削波指纹 + 断流指纹 */
+    ESP_LOGW(TAG, "【探针·本曲汇总】样本 %d / 满幅样本 %d (%.3f%%) / 最长连续满幅 %d / 断流(>400ms) %d 次 / 最大间隔 %d ms",
+             (int)probe_total_samples, (int)probe_clip_samples,
+             probe_total_samples > 0 ? (double)probe_clip_samples * 100.0 / (double)probe_total_samples : 0.0,
+             (int)probe_clip_run_max, probe_gap_warn,
+             (int)(probe_gap_max_us / 1000));
+}
diff --git a/main/audio/music_player.h b/main/audio/music_player.h
new file mode 100644
index 0000000..669a547
--- /dev/null
+++ b/main/audio/music_player.h
@@ -0,0 +1,85 @@
+#ifndef MUSIC_PLAYER_H
+#define MUSIC_PLAYER_H
+
+#include <atomic>
+#include <string>
+
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+class AudioService;
+
+/**
+ * 本地音乐播放器（TF 卡 MP3）
+ *
+ * 与语音链路解耦：解码后的 PCM 经 AudioService::PushPcmToPlayback()
+ * 直接进播放队列，不经过 OpusCodecTask，语音通路零改动。
+ *
+ * 用法：
+ *   MusicPlayer::GetInstance().Initialize(audio_service);
+ *   MusicPlayer::GetInstance().PlayFile("/sdcard/test.mp3");
+ */
+class MusicPlayer {
+public:
+    static MusicPlayer& GetInstance();
+
+    void Initialize(AudioService* audio_service);
+
+    // 播放指定文件（会先停掉当前播放）。文件不存在 / 打不开返回 false。
+    bool PlayFile(const std::string& path);
+    // 请求停止并等待播放任务退出；任务未在超时内退出返回 false
+    bool Stop();
+    void Pause();
+    void Resume();
+
+    bool IsPlaying() const { return playing_.load(); }
+    bool IsPaused() const { return paused_.load(); }
+
+    /** 【自动续播】取走「本曲自然播完」标志（取一次即清）。
+     * 只在正常播完时置位；用户停止/暂停、队列满放弃、打不开文件都不置位。 */
+    bool TakeFinishedNaturally() { return finished_naturally_.exchange(false); }
+    const std::string& GetCurrentFile() const { return current_file_; }
+    int GetPositionMs() const { return position_ms_.load(); }
+    int GetDurationMs() const { return duration_ms_.load(); }
+    int GetSampleRate() const { return sample_rate_.load(); }
+    int GetChannels() const { return channels_.load(); }
+
+    // 诊断（不放音、纯查文件）：
+    // 打印文件头、ID3v2 标签大小、音频起始 32 字节、前 64KB 里合法 MP3 帧头的
+    // 数量与相邻间距（间距可反推真实码率，用来判定文件是不是真 MP3）
+    void DiagnoseFile(const std::string& path);
+
+private:
+    MusicPlayer() = default;
+    MusicPlayer(const MusicPlayer&) = delete;
+    MusicPlayer& operator=(const MusicPlayer&) = delete;
+
+    static void TaskEntry(void* arg);
+    void PlaybackLoop();
+    bool StopAndWait(int timeout_ms);
+    /* 音乐音量限制的开关：limit=true 限到 MUSIC_MAX_VOLUME，false 还原用户音量。
+     * 只改硬件不写 NVS，用户的偏好音量永远不会被音乐覆盖。 */
+    void ApplyVolumeLimit(bool limit);
+
+    AudioService* audio_service_ = nullptr;
+    TaskHandle_t task_handle_ = nullptr;
+
+    std::atomic<bool> playing_{false};
+    std::atomic<bool> paused_{false};
+    std::atomic<bool> stop_requested_{false};
+    /* 播放任务是否还活着：playing_ 变 false 之后任务还要做收尾（还原队列深度、
+     * 还原音量会写 NVS，几十毫秒），此时 6 KB 栈还没释放。
+     * 新建任务必须等这个标志落地，否则内部 SRAM 分配不到连续 6 KB（实测会失败），
+     * 而且旧任务的收尾会把新歌的音量/队列深度一起改掉。 */
+    std::atomic<bool> task_alive_{false};
+    std::atomic<int> position_ms_{0};
+    std::atomic<int> duration_ms_{0};
+    std::atomic<int> sample_rate_{0};
+    std::atomic<int> channels_{0};
+    int  saved_volume_ = -1;       /* 进音乐前的系统音量（播放结束还原） */
+    bool volume_limited_ = false;  /* 本次播放是否把音量限到了 MUSIC_MAX_VOLUME */
+    std::atomic<bool> finished_naturally_{false};  /* 本曲是否自然播完（供自动续播） */
+    std::string current_file_;
+};
+
+#endif  // MUSIC_PLAYER_H
diff --git a/main/audio/music_ui.cc b/main/audio/music_ui.cc
new file mode 100644
index 0000000..41b5112
--- /dev/null
+++ b/main/audio/music_ui.cc
@@ -0,0 +1,563 @@
+#include "audio/music_ui.h"
+#include "audio/music_player.h"
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include <esp_log.h>
+
+#include "board.h"          /* Board::GetInstance().GetBacklight() */
+#include "display/display.h"
+#include "display/lvgl_display/lvgl_theme.h"
+#include "material_symbols.h"
+
+#define TAG "MusicUi"
+
+
+/* ---------------- 布局常量（横屏 640 x 172） ---------------- */
+#define UI_W              640
+#define UI_H              172
+#define MARGIN            16
+
+/* 播放页 */
+#define TITLE_X           MARGIN
+#define TITLE_Y           6
+#define TITLE_W           430
+#define TITLE_H           34
+#define TIME_X            452
+#define TIME_Y            6
+#define TIME_W            172
+#define TIME_H            34
+#define BAR_X             MARGIN
+#define BAR_Y             46
+#define BAR_W             (UI_W - MARGIN * 2)
+#define BAR_H             16
+#define BTN_Y             76
+#define BTN_W             104
+#define BTN_H             74
+#define BTN_GAP           22
+
+/* 歌单页 */
+#define LIST_TITLE_W      360
+#define LIST_CLOSE_X      560
+#define LIST_CLOSE_Y      4
+#define LIST_CLOSE_W      64
+#define LIST_CLOSE_H      38
+#define LIST_Y            44
+#define LIST_H            122
+#define ROW_H             36
+
+
+/* ---------------- 颜色 ---------------- */
+/* 配色（用户指定）：纯黑底 + 白字；下面按钮白底黑符号；
+ * 只有「播放/暂停」那一个键是红底白符号。 */
+#define COLOR_BG          lv_color_hex(0x000000)
+#define COLOR_TEXT        lv_color_hex(0xFFFFFF)
+#define COLOR_BTN_BG      lv_color_hex(0xCCCCCC)
+#define COLOR_BTN_BG_HI   lv_color_hex(0x9A9A9A)
+#define COLOR_BTN_ICON    lv_color_hex(0x000000)
+#define COLOR_PLAY_BG     lv_color_hex(0xE53935)
+#define COLOR_PLAY_BG_HI  lv_color_hex(0xA82A27)
+#define COLOR_PLAY_ICON   lv_color_hex(0xFFFFFF)
+#define COLOR_BAR_BG      lv_color_hex(0x3A3A3A)
+#define COLOR_BAR_FG      lv_color_hex(0xFFFFFF)
+#define COLOR_ROW_BG      lv_color_hex(0x262626)
+#define COLOR_ROW_BG_HI   lv_color_hex(0x3C3C3C)
+
+MusicUi& MusicUi::GetInstance() {
+    static MusicUi instance;
+    return instance;
+}
+
+/* ---------------- 小工具 ---------------- */
+
+/* "/sdcard/痛仰乐队 - 公路之歌.mp3" -> "痛仰乐队 - 公路之歌" */
+static std::string BaseName(const std::string& path) {
+    size_t slash = path.find_last_of('/');
+    std::string n = (slash == std::string::npos) ? path : path.substr(slash + 1);
+    size_t dot = n.rfind('.');
+    if (dot != std::string::npos && dot > 0) {
+        n = n.substr(0, dot);
+    }
+    return n;
+}
+
+static const lv_font_t* TextFont(Display* d) {
+    auto* t = static_cast<LvglTheme*>(d->GetTheme());
+    return (t && t->text_font()) ? t->text_font()->font() : LV_FONT_DEFAULT;
+}
+
+static const lv_font_t* IconFont(Display* d) {
+    auto* t = static_cast<LvglTheme*>(d->GetTheme());
+    return (t && t->icon_font()) ? t->icon_font()->font() : LV_FONT_DEFAULT;
+}
+
+/* ---------------- 公开接口 ---------------- */
+
+void MusicUi::Initialize(Display* display, std::vector<std::string> files, AudioService* audio) {
+    display_ = display;
+    files_   = std::move(files);
+    audio_   = audio;
+    ESP_LOGI(TAG, "初始化：%d 首歌，display=%p（LVGL 对象延迟到第一次打开时再建，"
+                  "那时 assets 里的 common 中文字体已加载）",
+             (int)files_.size(), (void*)display_);
+}
+
+void MusicUi::Toggle() {
+    if (!IsAvailable()) {
+        ESP_LOGW(TAG, "不可用：display=%p 歌单=%d 首", (void*)display_, (int)files_.size());
+        return;
+    }
+    if (visible_) {
+        Hide();
+    } else {
+        Show();
+    }
+}
+
+void MusicUi::Show() {
+    if (!IsAvailable()) {
+        ESP_LOGW(TAG, "不可用，无法打开音乐界面");
+        return;
+    }
+    DisplayLockGuard lock(display_);
+    BuildLocked();
+    if (index_ >= 0) {
+        ShowPlayerLocked();
+    } else {
+        ShowListLocked();
+    }
+    SetVisibleLocked(true);
+    ESP_LOGI(TAG, "音乐界面已打开（%s）", index_ >= 0 ? "播放页" : "歌单页");
+}
+
+void MusicUi::Hide() {
+    if (display_ == nullptr || root_ == nullptr) {
+        visible_ = false;
+        return;
+    }
+    DisplayLockGuard lock(display_);
+    SetVisibleLocked(false);
+    ESP_LOGI(TAG, "音乐界面已关闭");
+}
+
+/* 主题换字体：整棵界面树 + 定时器一起销毁，下次 Show() 用新字体重建。
+ * 为什么不是逐个控件重设字体：文本字体与图标字体混在同一棵树里，逐个判断角色容易漏；
+ * 重建的心智负担最小，而且界面本来就是懒建的覆盖层。
+ * 定时器必须先删 —— 它每 500ms 会写 title_lbl_/time_lbl_，要抢在删控件前面。 */
+void MusicUi::OnThemeFontsChanged(const lv_font_t* text_font, const lv_font_t* icon_font) {
+    if (display_ == nullptr) {
+        return;
+    }
+    DisplayLockGuard lock(display_);
+    if (root_ == nullptr) {
+        return;                     /* 还没建过，下次 Show() 自然用新字体 */
+    }
+    if (text_font == build_text_font_ && icon_font == build_icon_font_) {
+        return;                     /* 字体对象没换（light<->dark 互换），界面保持不动 */
+    }
+
+    if (timer_ != nullptr) {
+        lv_timer_delete(timer_);
+        timer_ = nullptr;
+    }
+    lv_obj_del(root_);
+    root_             = nullptr;
+    list_page_        = nullptr;
+    player_page_      = nullptr;
+    list_cont_        = nullptr;
+    title_lbl_        = nullptr;
+    time_lbl_         = nullptr;
+    bar_              = nullptr;
+    play_lbl_         = nullptr;
+    build_text_font_  = nullptr;
+    build_icon_font_  = nullptr;
+    visible_          = false;      /* 树没了，视作已关闭；下次 Show() 用新字体重建 */
+    ESP_LOGW(TAG, "主题换字体：音乐界面已销毁，下次打开按新字体重建");
+}
+
+void MusicUi::OnDeviceStateChanged(DeviceState state) {
+    /* 只碰原子变量，不碰 LVGL —— 这个回调可能在任何任务的上下文里跑 */
+    auto& mp = MusicPlayer::GetInstance();
+
+    switch (state) {
+        case kDeviceStateListening:
+        case kDeviceStateSpeaking:
+        case kDeviceStateConnecting:
+            if (mp.IsPlaying() && !mp.IsPaused()) {
+                mp.Pause();
+                voice_paused_ = true;
+                ESP_LOGI(TAG, "[互斥] 语音占用，音乐已暂停");
+            }
+            break;
+
+        case kDeviceStateIdle:
+            if (voice_paused_) {
+                voice_paused_ = false;
+                mp.Resume();
+                ESP_LOGI(TAG, "[互斥] 对话结束，音乐续播");
+            }
+            break;
+
+        default:
+            break;
+    }
+}
