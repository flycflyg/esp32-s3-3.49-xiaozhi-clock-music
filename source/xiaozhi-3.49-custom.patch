+/* ---------------- 建界面（需已持锁） ---------------- */
+
+void MusicUi::BuildLocked() {
+    if (root_ != nullptr) {
+        return;   /* 只建一次 */
+    }
+
+    auto screen    = lv_screen_active();
+    const lv_font_t* tf = TextFont(display_);
+    const lv_font_t* ic = IconFont(display_);
+    build_text_font_ = tf;
+    build_icon_font_ = ic;
+    auto* theme = static_cast<LvglTheme*>(display_->GetTheme());
+
+    /* ---- 根覆盖层：铺满整屏，默认隐藏 ---- */
+    root_ = lv_obj_create(screen);
+    lv_obj_set_size(root_, UI_W, UI_H);
+    lv_obj_set_pos(root_, 0, 0);
+    lv_obj_set_style_radius(root_, 0, 0);
+    lv_obj_set_style_border_width(root_, 0, 0);
+    lv_obj_set_style_pad_all(root_, 0, 0);
+    lv_obj_set_style_bg_opa(root_, LV_OPA_COVER, 0);
+    lv_obj_remove_flag(root_, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_add_flag(root_, LV_OBJ_FLAG_HIDDEN);
+    /* 固定配色（不走主题）：纯黑底 + 白字，和待机时钟统一 */
+    lv_obj_set_style_bg_color(root_, COLOR_BG, 0);
+    lv_obj_set_style_text_color(root_, COLOR_TEXT, 0);
+    (void)theme;
+    ESP_LOGI(TAG, "配色：背景=0x000000 文字=0xFFFFFF（按钮白底黑符号，播放键红底）");
+    lv_obj_set_style_text_font(root_, tf, 0);
+
+    /* ================= 歌单页 ================= */
+    list_page_ = lv_obj_create(root_);
+    lv_obj_set_size(list_page_, UI_W, UI_H);
+    lv_obj_set_pos(list_page_, 0, 0);
+    lv_obj_set_style_radius(list_page_, 0, 0);
+    lv_obj_set_style_border_width(list_page_, 0, 0);
+    lv_obj_set_style_pad_all(list_page_, 0, 0);
+    lv_obj_set_style_bg_opa(list_page_, LV_OPA_TRANSP, 0);
+    lv_obj_remove_flag(list_page_, LV_OBJ_FLAG_SCROLLABLE);
+
+    lv_obj_t* lt = lv_label_create(list_page_);
+    lv_label_set_text_fmt(lt, "%s 本地音乐 (%d 首)", MATERIAL_SYMBOLS_MUSIC_NOTE, (int)files_.size());
+    lv_obj_set_style_text_font(lt, tf, 0);
+    lv_obj_set_style_text_color(lt, COLOR_TEXT, 0);   /* 主题会给 label 设黑字，必须显式改白 */
+    lv_obj_set_pos(lt, MARGIN, TITLE_Y);
+    lv_obj_set_width(lt, LIST_TITLE_W);
+    lv_label_set_long_mode(lt, LV_LABEL_LONG_MODE_DOTS);
+
+    lv_obj_t* close1 = lv_button_create(list_page_);
+    lv_obj_set_size(close1, LIST_CLOSE_W, LIST_CLOSE_H);
+    lv_obj_set_pos(close1, LIST_CLOSE_X, LIST_CLOSE_Y);
+    lv_obj_set_style_bg_color(close1, COLOR_BTN_BG, 0);
+    lv_obj_set_style_bg_color(close1, COLOR_BTN_BG_HI, LV_STATE_PRESSED);
+    lv_obj_set_style_radius(close1, 8, 0);
+    lv_obj_add_event_cb(close1, CloseCb, LV_EVENT_CLICKED, nullptr);
+    lv_obj_t* cl1 = lv_label_create(close1);
+    lv_label_set_text(cl1, MATERIAL_SYMBOLS_CLOSE);
+    lv_obj_set_style_text_font(cl1, ic, 0);
+    lv_obj_set_style_text_color(cl1, COLOR_BTN_ICON, 0);   /* 白底黑符号 */
+    lv_obj_center(cl1);
+
+    /* 歌单容器：纵向 flex，超过高度可滚动 */
+    list_cont_ = lv_obj_create(list_page_);
+    lv_obj_set_size(list_cont_, UI_W - MARGIN * 2, LIST_H);
+    lv_obj_set_pos(list_cont_, MARGIN, LIST_Y);
+    lv_obj_set_style_radius(list_cont_, 0, 0);
+    lv_obj_set_style_border_width(list_cont_, 0, 0);
+    lv_obj_set_style_pad_all(list_cont_, 0, 0);
+    lv_obj_set_style_pad_row(list_cont_, 4, 0);
+    lv_obj_set_style_bg_opa(list_cont_, LV_OPA_TRANSP, 0);
+    lv_obj_set_flex_flow(list_cont_, LV_FLEX_FLOW_COLUMN);
+    lv_obj_add_flag(list_cont_, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_scroll_dir(list_cont_, LV_DIR_VER);
+
+    for (size_t i = 0; i < files_.size(); i++) {
+        lv_obj_t* row = lv_button_create(list_cont_);
+        lv_obj_set_width(row, lv_pct(100));
+        lv_obj_set_height(row, ROW_H);
+        lv_obj_set_style_bg_color(row, COLOR_ROW_BG, 0);
+        lv_obj_set_style_bg_color(row, COLOR_ROW_BG_HI, LV_STATE_PRESSED);
+        lv_obj_set_style_radius(row, 6, 0);
+        lv_obj_set_style_pad_left(row, 12, 0);
+        /* 下标存 i+1，0 表示「空」 */
+        lv_obj_set_user_data(row, (void*)(intptr_t)(i + 1));
+        lv_obj_add_event_cb(row, SongRowCb, LV_EVENT_CLICKED, nullptr);
+
+        std::string name = BaseName(files_[i]);
+        lv_obj_t* lbl = lv_label_create(row);
+        lv_label_set_text_fmt(lbl, "%s  %s", MATERIAL_SYMBOLS_MUSIC_NOTE, name.c_str());
+        lv_obj_set_style_text_font(lbl, tf, 0);
+        lv_obj_set_style_text_color(lbl, COLOR_TEXT, 0);
+        lv_obj_set_width(lbl, UI_W - MARGIN * 2 - 40);
+        lv_label_set_long_mode(lbl, LV_LABEL_LONG_MODE_SCROLL_CIRCULAR);
+        lv_obj_align(lbl, LV_ALIGN_LEFT_MID, 0, 0);
+    }
+
+    /* ================= 播放页 ================= */
+    player_page_ = lv_obj_create(root_);
+    lv_obj_set_size(player_page_, UI_W, UI_H);
+    lv_obj_set_pos(player_page_, 0, 0);
+    lv_obj_set_style_radius(player_page_, 0, 0);
+    lv_obj_set_style_border_width(player_page_, 0, 0);
+    lv_obj_set_style_pad_all(player_page_, 0, 0);
+    lv_obj_set_style_bg_opa(player_page_, LV_OPA_TRANSP, 0);
+    lv_obj_remove_flag(player_page_, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_add_flag(player_page_, LV_OBJ_FLAG_HIDDEN);
+
+    title_lbl_ = lv_label_create(player_page_);
+    lv_obj_set_style_text_font(title_lbl_, tf, 0);
+    lv_obj_set_style_text_color(title_lbl_, COLOR_TEXT, 0);   /* 歌名：黑底必须白字 */
+    lv_obj_set_pos(title_lbl_, TITLE_X, TITLE_Y);
+    lv_obj_set_width(title_lbl_, TITLE_W);
+    lv_label_set_long_mode(title_lbl_, LV_LABEL_LONG_MODE_SCROLL_CIRCULAR);
+    lv_label_set_text(title_lbl_, "—");
+
+    time_lbl_ = lv_label_create(player_page_);
+    lv_obj_set_style_text_font(time_lbl_, tf, 0);
+    lv_obj_set_style_text_color(time_lbl_, COLOR_TEXT, 0);
+    lv_obj_set_pos(time_lbl_, TIME_X, TIME_Y);
+    lv_obj_set_width(time_lbl_, TIME_W);
+    lv_label_set_long_mode(time_lbl_, LV_LABEL_LONG_MODE_CLIP);
+    lv_obj_set_style_text_align(time_lbl_, LV_TEXT_ALIGN_RIGHT, 0);
+    lv_label_set_text(time_lbl_, "0:00 / 0:00");
+
+    bar_ = lv_bar_create(player_page_);
+    lv_obj_set_size(bar_, BAR_W, BAR_H);
+    lv_obj_set_pos(bar_, BAR_X, BAR_Y);
+    lv_bar_set_range(bar_, 0, 1000);
+    lv_bar_set_value(bar_, 0, LV_ANIM_OFF);
+    lv_obj_set_style_radius(bar_, BAR_H / 2, LV_PART_MAIN);
+    lv_obj_set_style_radius(bar_, BAR_H / 2, LV_PART_INDICATOR);
+    lv_obj_set_style_bg_color(bar_, COLOR_BAR_BG, LV_PART_MAIN);
+    lv_obj_set_style_bg_color(bar_, COLOR_BAR_FG, LV_PART_INDICATOR);
+
+    /* 按钮：⏮ ▶/⏸ ⏭ | ←(歌单) ✕(关闭) */
+    struct { const char* icon; lv_event_cb_t cb; } btns[5] = {
+        { MATERIAL_SYMBOLS_SKIP_PREVIOUS, PrevCb },
+        { MATERIAL_SYMBOLS_PAUSE,         PlayPauseCb },   /* 文案在定时器里刷新 */
+        { MATERIAL_SYMBOLS_SKIP_NEXT,     NextCb },
+        { MATERIAL_SYMBOLS_ARROW_BACK,    ListCb },
+        { MATERIAL_SYMBOLS_CLOSE,         CloseCb },
+    };
+    for (int i = 0; i < 5; i++) {
+        lv_obj_t* b = lv_button_create(player_page_);
+        lv_obj_set_size(b, BTN_W, BTN_H);
+        lv_obj_set_pos(b, MARGIN + i * (BTN_W + BTN_GAP), BTN_Y);
+        /* i==1 是播放/暂停键：红底白符号；其余白底黑符号 */
+        const bool is_play = (i == 1);
+        lv_obj_set_style_bg_color(b, is_play ? COLOR_PLAY_BG : COLOR_BTN_BG, 0);
+        lv_obj_set_style_bg_color(b, is_play ? COLOR_PLAY_BG_HI : COLOR_BTN_BG_HI, LV_STATE_PRESSED);
+        lv_obj_set_style_radius(b, 10, 0);
+        lv_obj_add_event_cb(b, btns[i].cb, LV_EVENT_CLICKED, nullptr);
+
+        lv_obj_t* l = lv_label_create(b);
+        lv_label_set_text(l, btns[i].icon);
+        lv_obj_set_style_text_font(l, ic, 0);
+        /* 符号颜色必须显式指定：否则继承根节点的白字，白底上会看不见 */
+        lv_obj_set_style_text_color(l, is_play ? COLOR_PLAY_ICON : COLOR_BTN_ICON, 0);
+        lv_obj_center(l);
+        if (is_play) {
+            play_lbl_ = l;   /* 播放/暂停那个按钮的文字要动态换 */
+        }
+    }
+
+    /* 定时刷新进度 / 时间 / 播放暂停图标 */
+    timer_ = lv_timer_create(TimerCb, 500, this);
+    ESP_LOGI(TAG, "界面已建立（文字字体 %p / 图标字体 %p）", (void*)tf, (void*)ic);
+}
+
+void MusicUi::SetVisibleLocked(bool on) {
+    if (root_ == nullptr) {
+        visible_ = on;
+        return;
+    }
+    if (on) {
+        lv_obj_move_to_index(root_, -1);   /* 置顶，压住聊天界面 */
+        lv_obj_remove_flag(root_, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(root_, LV_OBJ_FLAG_HIDDEN);
+    }
+    visible_ = on;
+}
+
+/* ★两页统一显隐的唯一入口：显式设置全部页面的可见性，任何切页都走这里。
+ * 历史教训：显隐必须由这一个函数统一管，页面增减时只改这里，别在各自页面里各 hide 各的。 */
+void MusicUi::ShowOnlyLocked(Page page) {
+    struct { lv_obj_t* obj; Page own; } pages[] = {
+        { list_page_,       Page::kMusicList   },
+        { player_page_,     Page::kMusicPlayer },
+    };
+    for (const auto& p : pages) {
+        if (p.obj == nullptr) {
+            continue;
+        }
+        if (p.own == page) {
+            lv_obj_remove_flag(p.obj, LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(p.obj, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+}
+
+void MusicUi::ShowListLocked() {
+    ShowOnlyLocked(Page::kMusicList);
+}
+
+void MusicUi::ShowPlayerLocked() {
+    ShowOnlyLocked(Page::kMusicPlayer);
+    UpdatePlayerLocked();
+}
+
+void MusicUi::PlayIndexLocked(int index) {
+    if (index < 0 || index >= (int)files_.size()) {
+        return;
+    }
+    auto& mp = MusicPlayer::GetInstance();
+    // 不在这里调 Stop()：PlayFile 内部已经会 StopAndWait，
+    // 多调一次只会让持有显示锁的 LVGL 任务多停顿一次。
+    index_ = index;
+    voice_paused_ = false;
+
+    std::string name = BaseName(files_[index]);
+    if (title_lbl_) {
+        lv_label_set_text_fmt(title_lbl_, "%s  %s", MATERIAL_SYMBOLS_MUSIC_NOTE, name.c_str());
+    }
+    bool ok = mp.PlayFile(files_[index]);
+    ESP_LOGI(TAG, "播放第 %d 首: %s -> %s", index + 1, name.c_str(), ok ? "成功" : "失败");
+
+    ShowPlayerLocked();
+    SetVisibleLocked(true);
+}
+
+void MusicUi::UpdatePlayerLocked() {
+    auto& mp = MusicPlayer::GetInstance();
+    int pos = mp.GetPositionMs();
+    int dur = mp.GetDurationMs();
+
+    if (dur > 0) {
+        if (bar_) {
+            lv_bar_set_range(bar_, 0, dur);
+            lv_bar_set_value(bar_, pos > dur ? dur : pos, LV_ANIM_OFF);
+        }
+        if (time_lbl_) {
+            lv_label_set_text_fmt(time_lbl_, "%d:%02d / %d:%02d",
+                                  pos / 60000, (pos / 1000) % 60,
+                                  dur / 60000, (dur / 1000) % 60);
+        }
+    }
+    if (play_lbl_) {
+        /* 按钮显示「下一个动作」：暂停中 → 显示播放箭头 */
+        lv_label_set_text(play_lbl_, mp.IsPaused() ? MATERIAL_SYMBOLS_PLAY_ARROW
+                                                   : MATERIAL_SYMBOLS_PAUSE);
+    }
+}
+
+void MusicUi::TimerCb(lv_timer_t* t) {
+    auto* self = static_cast<MusicUi*>(lv_timer_get_user_data(t));
+    if (self == nullptr || self->display_ == nullptr) {
+        return;
+    }
+    /* 定时器跑在 LVGL 任务里，锁已被 lvgl_port 递归持有，这里再取一次是安全的 */
+    DisplayLockGuard lock(self->display_);
+    if (!self->visible_) {
+        return;
+    }
+
+    if (self->player_page_ == nullptr) {
+        return;
+    }
+    if (lv_obj_has_flag(self->player_page_, LV_OBJ_FLAG_HIDDEN)) {
+        return;
+    }
+    self->UpdatePlayerLocked();
+
+    /* ★自动续播：本曲自然播完 → 播下一首（循环）★
+     * 播放任务播完就退出，原来没有任何续播逻辑，所以歌放完会停在那里等手动点下一首。
+     * 挂在这个 500 ms 定时器里做，而不是在播放任务里直接 PlayFile ——
+     * 任务自己还没 vTaskDelete 时栈没释放，立刻再要 6 KB 栈会创建失败。 */
+    auto& mp = MusicPlayer::GetInstance();
+    if (mp.TakeFinishedNaturally() && !self->files_.empty()) {
+        const int n = (int)self->files_.size();
+        const int next = (self->index_ + 1) % n;
+        ESP_LOGI(TAG, "自动续播：第 %d 首播完 → 第 %d 首（共 %d 首）",
+                 self->index_ + 1, next + 1, n);
+        self->PlayIndexLocked(next);
+    }
+}
+
+/* ---------------- 交互回调 ---------------- */
+
+void MusicUi::SongRowCb(lv_event_t* e) {
+    auto* row = static_cast<lv_obj_t*>(lv_event_get_current_target(e));
+    int idx = (int)(intptr_t)lv_obj_get_user_data(row) - 1;
+    if (idx < 0) {
+        return;
+    }
+    ESP_LOGI(TAG, "点了第 %d 首", idx + 1);
+    MusicUi::GetInstance().PlayIndexLocked(idx);
+}
+
+void MusicUi::PrevCb(lv_event_t* e) {
+    auto& ui = MusicUi::GetInstance();
+    if (ui.files_.empty()) {
+        return;
+    }
+    int n = (int)ui.files_.size();
+    int next = (ui.index_ <= 0) ? (n - 1) : (ui.index_ - 1);
+    ui.PlayIndexLocked(next);
+}
+
+void MusicUi::NextCb(lv_event_t* e) {
+    auto& ui = MusicUi::GetInstance();
+    if (ui.files_.empty()) {
+        return;
+    }
+    int n = (int)ui.files_.size();
+    int next = (ui.index_ < 0 || ui.index_ + 1 >= n) ? 0 : (ui.index_ + 1);
+    ui.PlayIndexLocked(next);
+}
+
+void MusicUi::PlayPauseCb(lv_event_t* e) {
+    auto& ui = MusicUi::GetInstance();
+    auto& mp = MusicPlayer::GetInstance();
+
+    /* 一条都没加载（比如刚开机就打开界面按播放）→ 从上次那首或第一首开始 */
+    if (!mp.IsPlaying() && !mp.IsPaused()) {
+        ui.PlayIndexLocked(ui.index_ < 0 ? 0 : ui.index_);
+        return;
+    }
+    if (mp.IsPaused()) {
+        mp.Resume();
+        ESP_LOGI(TAG, "手动继续播放");
+    } else {
+        mp.Pause();
+        ESP_LOGI(TAG, "手动暂停");
+    }
+    ui.UpdatePlayerLocked();
+}
+
+void MusicUi::ListCb(lv_event_t* e) {
+    MusicUi::GetInstance().ShowListLocked();
+}
+
+void MusicUi::CloseCb(lv_event_t* e) {
+    auto& ui = MusicUi::GetInstance();
+    /* 退出音乐界面 = 停止播放（界面上没有单独的「停止」按钮）。
+     * 不停止的话：音乐继续在后台响，而且 75% 的音量上限会一直压着小智的音量。 */
+    auto& mp = MusicPlayer::GetInstance();
+    if (mp.IsPlaying()) {
+        mp.Stop();
+        ESP_LOGI(TAG, "关闭音乐界面 → 停止播放");
+    }
+    ui.Hide();
+}
+
