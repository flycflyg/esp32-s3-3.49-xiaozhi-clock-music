+
+void StandbyClock::Initialize(Display* display) {
+    if (display == nullptr) {
+        ESP_LOGW(TAG, "Initialize: display 为空，跳过");
+        return;
+    }
+    display_ = display;
+
+    /* ★千万不要在这里设 TZ！
+     * ota.cc 解析 server_time 时已经做过 ts += timezone_offset*60*1000，
+     * 也就是说 settimeofday 存进去的**已经是本地时间**；
+     * TZ 未设置（=UTC）时 localtime() 正好还原它。
+     * 之前设了 setenv("TZ","CST-8") → 又多加 8 小时 → 时钟时间不对的真凶。 */
+
+    Application::GetInstance().GetStateMachine().AddStateChangeListener(
+        [](DeviceState, DeviceState new_state) {
+            StandbyClock::GetInstance().OnDeviceStateChanged(new_state);
+        });
+
+    {
+        DisplayLockGuard lock(display_);
+        if (timer_ == nullptr) {
+            timer_ = lv_timer_create(TimerCb, TICK_MS, this);
+        }
+    }
+    ESP_LOGI(TAG, "待机时钟就绪（idle 后 %d ms 出现；触摸/BOOT 单击进对话）", IDLE_DELAY_MS);
+}
+
+/* ---------------- 状态机侧（任意任务上下文，只碰标志位） ---------------- */
+
+void StandbyClock::OnDeviceStateChanged(DeviceState state) {
+    if (state == kDeviceStateIdle) {
+        if (!want_show_) {
+            idle_since_ms_ = lv_tick_get();
+        }
+        want_show_ = true;
+    } else {
+        want_show_ = false;
+    }
+}
+
+/* ---------------- 显示/隐藏 ---------------- */
+
+void StandbyClock::Show() {
+    if (display_ == nullptr) {
+        return;
+    }
+    DisplayLockGuard lock(display_);
+    BuildLocked();
+    if (root_ == nullptr) {
+        return;
+    }
+    RefreshLocked(true);
+    lv_obj_move_to_index(root_, -1);
+    lv_obj_remove_flag(root_, LV_OBJ_FLAG_HIDDEN);
+    visible_ = true;
+}
+
+void StandbyClock::Hide() {
+    if (display_ == nullptr || root_ == nullptr) {
+        visible_ = false;
+        return;
+    }
+    DisplayLockGuard lock(display_);
+    lv_obj_add_flag(root_, LV_OBJ_FLAG_HIDDEN);
+    visible_ = false;
+}
+
+/* ---------------- 定时器（LVGL 任务上下文） ---------------- */
+
+void StandbyClock::TimerCb(lv_timer_t* t) {
+    auto* self = static_cast<StandbyClock*>(lv_timer_get_user_data(t));
+    if (self == nullptr || self->display_ == nullptr) {
+        return;
+    }
+    DisplayLockGuard lock(self->display_);
+
+    /* 音乐界面开着时时钟不抢屏（两者都是盖在聊天界面上的覆盖层） */
+    bool blocked = !self->want_show_ || MusicUi::GetInstance().IsVisible();
+
+    if (blocked) {
+        if (self->visible_) {
+            lv_obj_add_flag(self->root_, LV_OBJ_FLAG_HIDDEN);
+            self->visible_ = false;
+        }
+        return;
+    }
+    if (!self->visible_) {
+        if (lv_tick_get() - self->idle_since_ms_ < IDLE_DELAY_MS) {
+            return;
+        }
+        self->BuildLocked();
+        if (self->root_ == nullptr) {
+            return;
+        }
+        self->RefreshLocked(true);
+        lv_obj_move_to_index(self->root_, -1);
+        lv_obj_remove_flag(self->root_, LV_OBJ_FLAG_HIDDEN);
+        self->visible_ = true;
+        ESP_LOGI(TAG, "待机 → 显示翻页时钟");
+        return;
+    }
+    self->RefreshLocked(false);
+}
+
+/* ---------------- 建界面（需已持锁） ---------------- */
+
+void StandbyClock::BuildLocked() {
+    if (root_ != nullptr) {
+        return;
+    }
+    auto screen = lv_screen_active();
+    auto* theme = static_cast<LvglTheme*>(display_->GetTheme());
+    const lv_font_t* tf = (theme != nullptr && theme->text_font() != nullptr)
+                              ? theme->text_font()->font()
+                              : LV_FONT_DEFAULT;
+    build_text_font_ = tf;
+
+    /* ---- 根覆盖层：纯黑、铺满整屏、可点击（点一下进对话） ---- */
+    root_ = lv_obj_create(screen);
+    lv_obj_set_size(root_, UI_W, UI_H);
+    lv_obj_set_pos(root_, 0, 0);
+    lv_obj_set_style_radius(root_, 0, 0);
+    lv_obj_set_style_border_width(root_, 0, 0);
+    lv_obj_set_style_pad_all(root_, 0, 0);
+    lv_obj_set_style_bg_opa(root_, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(root_, COLOR_BG, 0);
+    lv_obj_set_style_text_color(root_, COLOR_TEXT, 0);
+    lv_obj_remove_flag(root_, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_add_flag(root_, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_flag(root_, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_add_event_cb(root_, RootClickCb, LV_EVENT_CLICKED, nullptr);
+
+    /* ---- 两张翻页卡片：时 / 分（深灰底、白字） ---- */
+    const int total_w = CARD_W * 2 + CARD_GAP;
+    const int x0 = (UI_W - total_w) / 2;
+    const int card_y = (UI_H - CARD_H) / 2;
+    for (int i = 0; i < 2; i++) {
+        card_[i] = lv_obj_create(root_);
+        lv_obj_set_size(card_[i], CARD_W, CARD_H);
+        lv_obj_set_pos(card_[i], x0 + i * (CARD_W + CARD_GAP), card_y);
+        lv_obj_set_style_radius(card_[i], CARD_RADIUS, 0);
+        lv_obj_set_style_border_width(card_[i], 0, 0);
+        lv_obj_set_style_pad_all(card_[i], 0, 0);
+        lv_obj_set_style_bg_opa(card_[i], LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(card_[i], COLOR_CARD, 0);
+        lv_obj_remove_flag(card_[i], LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_remove_flag(card_[i], LV_OBJ_FLAG_CLICKABLE);
+
+        lv_obj_t* seam = lv_obj_create(card_[i]);
+        lv_obj_set_size(seam, CARD_W - 12, SEAM_H);
+        lv_obj_align(seam, LV_ALIGN_CENTER, 0, 0);
+        lv_obj_set_style_radius(seam, 0, 0);
+        lv_obj_set_style_border_width(seam, 0, 0);
+        lv_obj_set_style_bg_opa(seam, LV_OPA_60, 0);
+        lv_obj_set_style_bg_color(seam, COLOR_BG, 0);
+        lv_obj_remove_flag(seam, LV_OBJ_FLAG_CLICKABLE);
+
+        digit_[i] = lv_label_create(card_[i]);
+        lv_obj_set_style_text_font(digit_[i], &font_clock_140_4, 0);
+        lv_obj_set_style_text_color(digit_[i], COLOR_TEXT, 0);
+        lv_label_set_text(digit_[i], "--");
+        lv_obj_center(digit_[i]);
+
+        /* 翻页盖板：建在数字之后才盖得住；动画时从 0 长到卡片高 */
+        flap_[i] = lv_obj_create(card_[i]);
+        lv_obj_set_size(flap_[i], CARD_W, 0);
+        lv_obj_set_pos(flap_[i], 0, 0);
+        lv_obj_set_style_radius(flap_[i], 0, 0);
+        lv_obj_set_style_border_width(flap_[i], 0, 0);
+        lv_obj_set_style_pad_all(flap_[i], 0, 0);
+        lv_obj_set_style_bg_opa(flap_[i], LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(flap_[i], COLOR_CARD, 0);
+        lv_obj_remove_flag(flap_[i], LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_add_flag(flap_[i], LV_OBJ_FLAG_HIDDEN);
+    }
+
+    /* ---- 左侧日期：左列两行「11月」「10日」，右列逐字竖排年份（符合竖排从右往左） ---- */
+    date_yr_lbl_ = lv_label_create(root_);
+    lv_obj_set_style_text_font(date_yr_lbl_, tf, 0);
+    lv_obj_set_style_text_color(date_yr_lbl_, COLOR_TEXT, 0);
+    lv_obj_set_style_text_align(date_yr_lbl_, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_width(date_yr_lbl_, COL_W);
+    lv_obj_align(date_yr_lbl_, LV_ALIGN_LEFT_MID, COL_PAD + DATE_W + DATE_COL_GAP, 0);
+    lv_label_set_text(date_yr_lbl_, "");
+
+    date_lbl_ = lv_label_create(root_);
+    lv_obj_set_style_text_font(date_lbl_, tf, 0);
+    lv_obj_set_style_text_color(date_lbl_, COLOR_TEXT, 0);
+    lv_obj_set_style_text_align(date_lbl_, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_width(date_lbl_, DATE_W);
+    lv_obj_align(date_lbl_, LV_ALIGN_LEFT_MID, COL_PAD, 0);
+    lv_label_set_text(date_lbl_, "");
+
+    /* ---- 右侧：内列竖排星期，外列竖排农历（与左侧两列对称） ---- */
+    week_lbl_ = lv_label_create(root_);
+    lv_obj_set_style_text_font(week_lbl_, tf, 0);
+    lv_obj_set_style_text_color(week_lbl_, COLOR_TEXT, 0);
+    lv_obj_set_style_text_align(week_lbl_, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_width(week_lbl_, COL_W);
+    lv_obj_align(week_lbl_, LV_ALIGN_RIGHT_MID, -(COL_PAD + COL_W + DATE_COL_GAP), 0);
+    lv_label_set_text(week_lbl_, "");
+
+    lunar_lbl_ = lv_label_create(root_);
+    lv_obj_set_style_text_font(lunar_lbl_, tf, 0);
+    lv_obj_set_style_text_color(lunar_lbl_, COLOR_TEXT, 0);
+    lv_obj_set_style_text_align(lunar_lbl_, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_width(lunar_lbl_, COL_W);
+    lv_obj_align(lunar_lbl_, LV_ALIGN_RIGHT_MID, -COL_PAD, 0);
+    lv_label_set_text(lunar_lbl_, "");
+
+    ESP_LOGI(TAG, "时钟界面已建立（文字字体 %p line_height=%d，卡片 %dx%d）",
+             (void*)tf, tf != nullptr ? tf->line_height : -1, CARD_W, CARD_H);
+}
+
+/* ---------------- 刷新 + 翻页动画（需已持锁） ---------------- */
+
+void StandbyClock::RefreshLocked(bool force) {
+    time_t now = time(nullptr);
+    struct tm tm_buf;
+    localtime_r(&now, &tm_buf);
+
+    /* OTA 校时才 settimeofday，没联网时年份是 1970 → 显示占位 */
+    bool valid = (tm_buf.tm_year + 1900) >= 2025;
+    int hh = valid ? tm_buf.tm_hour : -1;
+    int mm = valid ? tm_buf.tm_min : -1;
+
+    if (force || hh != last_hh_) {
+        char buf[8];
+        if (valid) {
+            snprintf(buf, sizeof(buf), "%02d", hh);
+        } else {
+            snprintf(buf, sizeof(buf), "--");
+        }
+        lv_label_set_text(digit_[0], buf);
+        last_hh_ = hh;
+    }
+
+    if (force || mm != last_mm_) {
+        char buf[8];
+        if (valid) {
+            snprintf(buf, sizeof(buf), "%02d", mm);
+        } else {
+            snprintf(buf, sizeof(buf), "--");
+        }
+        lv_label_set_text(digit_[1], buf);
+
+        if (!force && valid && flap_[1] != nullptr) {
+            lv_obj_remove_flag(flap_[1], LV_OBJ_FLAG_HIDDEN);
+            lv_obj_set_height(flap_[1], 0);
+            lv_anim_t a;
+            lv_anim_init(&a);
+            lv_anim_set_var(&a, flap_[1]);
+            lv_anim_set_exec_cb(&a, FlapAnimCb);
+            lv_anim_set_values(&a, 0, CARD_H);
+            lv_anim_set_duration(&a, 320);
+            lv_anim_set_path_cb(&a, lv_anim_path_ease_in_out);
+            lv_anim_set_completed_cb(&a, [](lv_anim_t* anim) {
+                auto* obj = static_cast<lv_obj_t*>(lv_anim_get_user_data(anim));
+                if (obj != nullptr) {
+                    lv_obj_add_flag(obj, LV_OBJ_FLAG_HIDDEN);
+                }
+            });
+            lv_anim_set_user_data(&a, flap_[1]);
+            lv_anim_start(&a);
+        }
+        last_mm_ = mm;
+    }
+
+    if (force || tm_buf.tm_yday != last_yday_) {
+        if (valid) {
+            char yr[16];
+            char md[24];
+            char wk[16];
+            snprintf(yr, sizeof(yr), "%d年", tm_buf.tm_year + 1900);
+            /* 数字与「月」「日」各自独占一行：11 / 月 / 10 / 日
+             * 既满足「11 不被拆成 1、1」，也满足「月、日另起一行」 */
+            snprintf(md, sizeof(md), "%d\n月\n%d\n日", tm_buf.tm_mon + 1, tm_buf.tm_mday);
+            snprintf(wk, sizeof(wk), "星期%s", kWeekday[tm_buf.tm_wday]);
+            SetVerticalText(date_yr_lbl_, yr);
+            lv_label_set_text(date_lbl_, md);
+            SetVerticalText(week_lbl_, wk);
+            char lunar[48];
+            if (SolarToLunarText(tm_buf.tm_year + 1900, tm_buf.tm_mon + 1, tm_buf.tm_mday,
+                                 lunar, sizeof(lunar))) {
+                SetVerticalText(lunar_lbl_, lunar);
+            } else {
+                SetVerticalText(lunar_lbl_, "");
+                lunar[0] = '\0';
+            }
+            if (force) {
+                ESP_LOGI(TAG, "农历：%s", lunar[0] != '\0' ? lunar : "(超出 1900-2100)");
+            }
+        } else {
+            SetVerticalText(date_yr_lbl_, "");
+            lv_label_set_text(date_lbl_, "时间未同步");
+            SetVerticalText(week_lbl_, "");
+            SetVerticalText(lunar_lbl_, "");
+        }
+        last_yday_ = tm_buf.tm_yday;
+
+        if (force) {
+            ESP_LOGI(TAG, "时钟时间：%04d-%02d-%02d %02d:%02d:%02d（TZ=%s, %s）",
+                     tm_buf.tm_year + 1900, tm_buf.tm_mon + 1, tm_buf.tm_mday,
+                     tm_buf.tm_hour, tm_buf.tm_min, tm_buf.tm_sec,
+                     getenv("TZ") != nullptr ? getenv("TZ") : "未设置(=UTC)",
+                     valid ? "有效" : "无效");
+        }
+    }
+}
+
+void StandbyClock::FlapAnimCb(void* var, int32_t v) {
+    lv_obj_set_height(static_cast<lv_obj_t*>(var), v);
+}
+
+/* ---------------- 交互 ---------------- */
+
+void StandbyClock::RootClickCb(lv_event_t* e) {
+    auto& app = Application::GetInstance();
+    if (app.GetDeviceState() != kDeviceStateIdle) {
+        return;
+    }
+    ESP_LOGI(TAG, "点屏幕 → 进入对话");
+    app.ToggleChatState();
+}
+
+/* ---------------- 主题换字体：整棵树销毁，下次重建 ---------------- */
+
+void StandbyClock::OnThemeFontsChanged(const lv_font_t* text_font, const lv_font_t* icon_font) {
+    if (display_ == nullptr) {
+        return;
+    }
+    DisplayLockGuard lock(display_);
+    if (root_ == nullptr) {
+        return;
+    }
+    if (text_font == build_text_font_) {
+        return;
+    }
+    DestroyLocked();
+    ESP_LOGW(TAG, "主题换字体：时钟界面已销毁，下次显示按新字体重建");
+}
+
+void StandbyClock::DestroyLocked() {
+    if (timer_ != nullptr) {
+        lv_timer_delete(timer_);
+        timer_ = nullptr;
+    }
+    if (root_ != nullptr) {
+        lv_obj_del(root_);
+        root_ = nullptr;
+    }
+    card_[0] = card_[1] = nullptr;
+    digit_[0] = digit_[1] = nullptr;
+    flap_[0] = flap_[1] = nullptr;
+    date_lbl_ = nullptr;
+    date_yr_lbl_ = nullptr;
+    week_lbl_ = nullptr;
+    lunar_lbl_ = nullptr;
+    build_text_font_ = nullptr;
+    build_icon_font_ = nullptr;
+    visible_ = false;
+    last_hh_ = last_mm_ = last_yday_ = -1;
+}
diff --git a/main/display/standby_clock.h b/main/display/standby_clock.h
