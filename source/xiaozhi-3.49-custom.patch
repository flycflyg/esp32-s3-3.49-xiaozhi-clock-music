+/* ---------------- 竖排小工具：每个 UTF-8 字符占一行 ---------------- */
+
+static void SetVerticalText(lv_obj_t* lbl, const std::string& s) {
+    if (lbl == nullptr) {
+        return;
+    }
+    std::string out;
+    for (size_t i = 0; i < s.size();) {
+        unsigned char c = (unsigned char)s[i];
+        size_t n = 1;
+        if (c >= 0xF0) {
+            n = 4;
+        } else if (c >= 0xE0) {
+            n = 3;
+        } else if (c >= 0xC0) {
+            n = 2;
+        }
+        out.append(s, i, n);
+        i += n;
+        if (i < s.size()) {
+            out += '\n';
+        }
+    }
+    lv_label_set_text(lbl, out.c_str());
+}
