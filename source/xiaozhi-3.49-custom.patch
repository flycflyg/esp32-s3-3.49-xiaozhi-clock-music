+bool AudioService::PushPcmToPlayback(std::vector<int16_t>&& pcm, uint32_t timestamp) {
+    if (pcm.empty()) {
+        return false;
+    }
+
+    std::unique_lock<std::mutex> lock(audio_queue_mutex_);
+    /* 队列满时不阻塞、也不丢数据：直接返回 false，让调用方稍后重试。
+     * 关键：这两个检查在 std::move(pcm) 之前，失败时 pcm 保持原样。 */
+    if (service_stopped_.load() || audio_playback_queue_.size() >= (size_t)playback_queue_limit_.load()) {
+        return false;
+    }
+
+    auto task = std::make_unique<AudioTask>();
+    task->type = kAudioTaskTypeDecodeToPlaybackQueue;
+    task->timestamp = timestamp;
+    task->pcm = std::move(pcm);
+    audio_playback_queue_.push_back(std::move(task));
+    audio_queue_cv_.notify_all();
+    return true;
+}
+
+void AudioService::SetPlaybackQueueLimit(int tasks) {
+    if (tasks < 1) {
+        tasks = MAX_PLAYBACK_TASKS_IN_QUEUE;
+    }
+    playback_queue_limit_.store(tasks);
+    ESP_LOGI(TAG, "播放队列深度 → %d 块", tasks);
+}
+
+void AudioService::ClearPlaybackQueue() {
+    /* 只清"待播放 PCM"：停止流式播放时用。不动 Opus 解码器（语音链路可能正在用）。 */
+    bool notify_drained = false;
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        ++playback_generation_;
+        audio_playback_queue_.clear();
+        notify_drained = MarkPlaybackDrainedLocked();
+        audio_queue_cv_.notify_all();
+    }
+    if (notify_drained && callbacks_.on_playback_drained) {
+        callbacks_.on_playback_drained();
+    }
+}
+
+int AudioService::GetOutputSampleRate() const {
+    if (codec_ != nullptr) {
+        return codec_->output_sample_rate();
+    }
+    return 24000;
+}
